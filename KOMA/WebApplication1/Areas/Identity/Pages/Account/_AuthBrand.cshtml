@* Left brand panel shared by the account pages (Forgot / Reset password, Confirm email) - same as Login. *@
<section class="koma-login-brand" aria-label="KOMA">
    <a asp-area="" asp-page="/Index" class="koma-login-logo"><span lang="ja">こま</span> KOMA</a>
    <div>
        <p class="koma-login-eyebrow">WELCOME TO KOMA</p>
        <h1>@KOMA.Models.KomaBrand.InvitationHeading</h1>
        <p class="koma-login-description">A familiar place to return to.</p>
    </div>
    <p class="koma-login-brand-note">Japanese-inspired dining.</p>
</section>
