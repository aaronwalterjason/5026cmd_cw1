@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/koma-login.css" asp-append-version="true" />
<div class="koma-login">
    <div class="koma-login-shell">
        <partial name="_AuthBrand" />
        <section class="koma-login-form-panel" aria-labelledby="fp-title">
            <div class="koma-login-form-content">
                <p class="koma-login-eyebrow">YOUR ACCOUNT</p>
                @if (Model.Done)
                {
                    <h2 id="fp-title">Check your email</h2>
                    <p class="koma-login-intro">If <b>@Model.Email</b> has a KOMA account, we've sent a link to reset your password. It can take a minute — please check your spam folder too.</p>
                    <a asp-page="./Login" class="koma-login-submit">Back to log in <span aria-hidden="true">↗</span></a>
                }
                else
                {
                    <h2 id="fp-title">Forgot your password?</h2>
                    <p class="koma-login-intro">Enter the email you signed up with and we'll send you a link to choose a new password.</p>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="koma-login-errors" role="alert"></div>
                        <div class="koma-login-field">
                            <label asp-for="Email">Email address</label>
                            <input asp-for="Email" type="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="you@example.com" aria-required="true" />
                            <span asp-validation-for="Email" class="koma-login-field-error"></span>
                        </div>
                        <button type="submit" class="koma-login-submit">Send reset link <span aria-hidden="true">↗</span></button>
                    </form>
                    <p class="koma-login-register">Remembered it? <a asp-page="./Login">Log in</a></p>
                }
                <a asp-area="" asp-page="/Index" class="koma-login-back">← Back to home</a>
            </div>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
