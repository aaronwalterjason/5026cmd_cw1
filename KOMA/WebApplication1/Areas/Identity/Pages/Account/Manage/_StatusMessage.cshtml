@model string

@* Only errors are shown here; success messages ("Your password has been changed." etc.) show as the shared
   pop-up from the layout (Pages/Shared/_Toast.cshtml), which skips messages starting with "Error". *@
@if (!String.IsNullOrEmpty(Model) && Model.StartsWith("Error"))
{
    var statusMessageClass = "danger";
    <div class="alert alert-@statusMessageClass alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        @Model
    </div>
}
