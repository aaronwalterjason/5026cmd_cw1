@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/koma-login.css" asp-append-version="true" />
<div class="koma-login">
    <div class="koma-login-shell">
        <partial name="_AuthBrand" />
        <section class="koma-login-form-panel" aria-labelledby="rp-title">
            <div class="koma-login-form-content">
                <p class="koma-login-eyebrow">YOUR ACCOUNT</p>
                @if (Model.Done)
                {
                    <h2 id="rp-title">Password changed</h2>
                    <p class="koma-login-intro">You can now log in with your new password.</p>
                    <a asp-page="./Login" class="koma-login-submit">Log in <span aria-hidden="true">↗</span></a>
                }
                else if (string.IsNullOrEmpty(Model.Code))
                {
                    <h2 id="rp-title">Link missing</h2>
                    <p class="koma-login-intro">Open the link from your email again, or ask for a new one.</p>
                    <a asp-page="./ForgotPassword" class="koma-login-submit">Send a new link <span aria-hidden="true">↗</span></a>
                }
                else
                {
                    <h2 id="rp-title">Choose a new password</h2>
                    <p class="koma-login-intro">Enter your email and a new password (at least 6 characters).</p>
                    <form method="post">
                        <input type="hidden" asp-for="Code" />
                        <div asp-validation-summary="ModelOnly" class="koma-login-errors" role="alert"></div>
                        <div class="koma-login-field">
                            <label asp-for="Input.Email">Email address</label>
                            <input asp-for="Input.Email" type="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="you@example.com" />
                            <span asp-validation-for="Input.Email" class="koma-login-field-error"></span>
                        </div>
                        <div class="koma-login-field">
                            <label asp-for="Input.Password">New password</label>
                            <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="koma-login-field-error"></span>
                        </div>
                        <div class="koma-login-field">
                            <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="koma-login-field-error"></span>
                        </div>
                        <button type="submit" class="koma-login-submit">Save new password <span aria-hidden="true">↗</span></button>
                    </form>
                }
                <a asp-area="" asp-page="/Index" class="koma-login-back">← Back to home</a>
            </div>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
