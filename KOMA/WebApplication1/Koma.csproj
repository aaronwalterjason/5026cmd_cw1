<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Check your installed SDK version, then set TargetFramework to match.
         This machine has .NET 10 installed, so this targets net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KOMA</RootNamespace>
    <AssemblyName>KOMA</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>koma-5026cmd-dev</UserSecretsId>
    <!-- Only report package vulnerabilities rated moderate or higher (low ones in design-time tools
         otherwise stop Update-Database in the Package Manager Console). -->
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Microsoft.VisualStudio.Web.CodeGeneration.Design (Visual Studio's "Add Scaffolded Item" wizard) was removed:
         it pulls in Roslyn 4.14, which clashes with the Roslyn 5.0 used by EF Core Design and makes
         Add-Migration fail with "Could not load type ... Microsoft.CodeAnalysis.Workspaces". The app never uses it.
         Visual Studio offers to add it back if you run the scaffolding wizard - remove it again before Add-Migration. -->
    <!-- Overrides the vulnerable 9.0.4 version pulled in by SqlClient (NU1902 / GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
