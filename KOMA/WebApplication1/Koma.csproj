<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Check your installed SDK version, then set TargetFramework to match.
         This machine has .NET 10 installed, so this targets net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KOMA</RootNamespace>
    <AssemblyName>KOMA</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>koma-5026cmd-dev</UserSecretsId>
    <!-- NU1608: the scaffolding tool (CodeGeneration.Design) wants Roslyn 4.14 while EF Core Design uses 5.0.
         Design-time only and harmless, but the Package Manager Console stops on it. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- Only report package vulnerabilities rated moderate or higher (low ones in design-time tools
         otherwise stop Update-Database in the Package Manager Console). -->
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.0" />
    <!-- Overrides the vulnerable 9.0.4 version pulled in by SqlClient (NU1902 / GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Override the vulnerable 6.12.1 versions pulled in by CodeGeneration.Design (NU1901 / GHSA-g4vj-cjjj-v7hg). -->
    <PackageReference Include="NuGet.Packaging" Version="6.12.5" />
    <PackageReference Include="NuGet.Protocol" Version="6.12.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
