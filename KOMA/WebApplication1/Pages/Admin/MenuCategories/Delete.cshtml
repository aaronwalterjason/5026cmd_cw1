@page "{id:int}"
@model KOMA.Pages.Admin.MenuCategories.DeleteModel
@{
    ViewData["Title"] = "Delete Menu Category";
}

<h1>Delete Menu Category</h1>

<div class="alert alert-warning">
    Are you sure you want to delete <strong>@Model.Category.Name</strong>? This cannot be undone.
</div>

<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input type="hidden" asp-for="Category.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>
