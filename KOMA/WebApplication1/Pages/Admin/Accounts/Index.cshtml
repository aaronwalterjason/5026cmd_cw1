@page
@model KOMA.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = Model.CurrentGroup is null ? "Accounts" : Model.CurrentGroup.Title + " · Accounts";
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.CurrentGroup is null)
{
    @* ================= Choose a group =================
       Three cards; hovering one grows it to 1.5x while the other two shrink to 0.75x (total width stays the same).
       The rust こま fill rests at 75% and goes to 100% on hover. Clicking grows the card to fill the area, then opens the group. *@
    <div class="acc-head">
        <h1 class="mb-0">Accounts</h1>
        <span class="acc-sub">Choose who you want to manage</span>
    </div>
    <div class="acc-row" id="acc-row">
        @foreach (var g in KOMA.Pages.Admin.Accounts.IndexModel.Groups)
        {
            var n = Model.CountFor(g);
            <a class="acc-card" asp-page="./Index" asp-route-group="@g.Key" aria-label="@g.Title: @n @g.Subtitle">
                <span class="acc-fill" aria-hidden="true"></span>
                <span class="acc-kana" aria-hidden="true"><span>こ</span><span>ま</span></span>
                <span class="acc-text">
                    <span class="acc-title">@g.Title</span>
                    <span class="acc-count">@n</span>
                    <span class="acc-cap">@g.Subtitle</span>
                </span>
            </a>
        }
    </div>
}
else
{
    var g = Model.CurrentGroup;
    var myId = Model.MyId;
    @* ================= One group: an ID badge per person =================
       Band colour per group (Shrine palette): Customers ochre, Staff pine green, Admins vermilion.
       Each badge: initials, name, email, phone, two numbers, and (Staff/Admins only) the role switch, which asks
       to confirm first. Customers can't be given a staff/admin role. *@
    <div class="acc-group-head">
        <a asp-page="./Index" class="acc-back">← All accounts</a>
        <h1 class="mb-0">@g.Title</h1>
        <span class="acc-sub">@Model.CountFor(g) @g.Subtitle</span>
        <input type="search" placeholder="Search" id="acc-search" class="acc-search" hidden="@Model.IsSchedule" aria-label="Search @g.Title.ToLowerInvariant()" autocomplete="off" />
    </div>

    @if (g.Role == "Staff")
    {
        @* Team (ID badges) | Schedule (duty schedule, _Schedule.cshtml) - same full-width switch as Orders *@
        <nav class="ob-switch acc-switch" aria-label="Staff view">
            <a asp-page="./Index" asp-route-group="staff" class="@(Model.IsSchedule ? "" : "is-on")"><b>Team</b><span>@Model.CountFor(g) staff</span></a>
            <a asp-page="./Index" asp-route-group="staff" asp-route-view="schedule" class="@(Model.IsSchedule ? "is-on" : "")"><b>Schedule</b><span>@((Model.Schedule?.Month ?? DateOnly.FromDateTime(DateTime.Today)).ToString("MMMM"))</span></a>
        </nav>
    }
    if (Model.IsSchedule && Model.Schedule is not null)
    {
        <div id="sc-wrap"><partial name="_Schedule" model="Model.Schedule" /></div>
    }
    else
    {
    if (!Model.Shown.Any())
    {
        <partial name="_Empty" model='new EmptyState("people", $"No {g.Title.ToLowerInvariant()} yet", g.Role == "Customer" ? "Customers appear here when they sign up." : null)' />
    }
    else
    {
        <div class="acc-badges acc-badges--@g.Key" id="acc-badges">
            @foreach (var a in Model.Shown)
            {
                var name = KOMA.Pages.Admin.Accounts.IndexModel.DisplayName(a);
                var stats = Model.StatsFor(a.UserId);
                var me = a.UserId == myId;
                @* every badge opens the details panel (customer card, or the staff / admin card) *@
                <article class="acc-badge" data-search="@($"{name} {a.Email} {a.Phone}".ToLowerInvariant())" data-id="@a.UserId" tabindex="0" role="button" aria-label="@("Open details for " + name)">
                    <div class="acc-badge-band">
                        <span class="acc-badge-kana" aria-hidden="true">こま</span>
                        <span class="acc-badge-role">@KOMA.Pages.Admin.Accounts.IndexModel.BadgeLabel(g)</span>
                        @if (me)
                        {
                            <span class="acc-badge-you">YOU</span>
                        }
                    </div>
                    <span class="acc-badge-av" aria-hidden="true">@KOMA.Pages.Admin.Accounts.IndexModel.Initials(a)</span>
                    <h2 class="acc-badge-name" title="@name">@name</h2>
                    <div class="acc-badge-mail" title="@a.Email">@a.Email</div>
                    <div class="acc-badge-phone">@(string.IsNullOrWhiteSpace(a.Phone) ? "No phone number" : a.Phone)</div>
                    <div class="acc-badge-stats">
                        <div><b>@stats.First.Value</b><span>@stats.First.Label</span></div>
                        <div><b>@stats.Second.Value</b><span>@stats.Second.Label</span></div>
                    </div>
                    @if (a.Role != "Customer")
                    {
                    <form method="post" asp-route-group="@g.Key" class="acc-badge-actions js-role-form" data-email="@a.Email" data-current="@a.Role">
                        <input type="hidden" name="userId" value="@a.UserId" />
                        <select name="role" class="acc-badge-select" aria-label="Role for @a.Email">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                if (role == a.Role)
                                {
                                    <option value="@role" selected>@(role == "Administrator" ? "Admin" : role)</option>
                                }
                                else
                                {
                                    <option value="@role">@(role == "Administrator" ? "Admin" : role)</option>
                                }
                            }
                        </select>
                        <button type="submit" class="acc-badge-btn">Update</button>
                    </form>
                    }
                </article>
            }
        </div>
        <div class="acc-none" id="acc-none" hidden><partial name="_Empty" model='new EmptyState("search", "No one matches", "Try a name, email or phone number.")' /></div>
        @* Details panel (slides in from the right). Filled by ?handler=Detail&id=... - _CustomerPanel.cshtml or _StaffPanel.cshtml *@
        <div class="cp-veil" id="cp-veil" hidden></div>
        <div class="cp-wrap" id="cp-wrap" style="--cp-band:@(g.Role == "Administrator" ? "#d0442b" : g.Role == "Staff" ? "#42602d" : "#c39143")" data-url="@Url.Page("./Index", "Detail", new { group = g.Key })"></div>
    }
    }
}

@section Scripts {
    <script>
        // Ask before changing someone's role (shared KOMA pop-up, js/koma-confirm.js). Only when the role really changes.
        document.querySelectorAll('form.js-role-form').forEach(form => form.addEventListener('submit', e => {
            const role = form.querySelector('select[name="role"]').value;
            const current = form.dataset.current, who = form.dataset.email;
            if (role === current || !window.KomaConfirm) return;
            e.preventDefault();
            const toAdmin = role === 'Administrator';
            KomaConfirm.open({
                tone: 'warn', icon: 'shield',
                title: toAdmin ? `Make ${who} an Administrator?` : `Change ${who} to ${role}?`,
                ok: 'Confirm', no: 'Cancel',
                onOk: () => HTMLFormElement.prototype.submit.call(form)
            });
        }));

        // Search the badges on this page by name, email or phone (no reload).
        (() => {
            const box = document.getElementById('acc-search');
            if (!box) return;
            box.addEventListener('input', () => {
                const q = box.value.trim().toLowerCase();
                let shown = 0;
                document.querySelectorAll('#acc-badges .acc-badge').forEach(b => {
                    const ok = !q || b.dataset.search.includes(q);
                    b.hidden = !ok;
                    if (ok) shown++;
                });
                const none = document.getElementById('acc-none');
                if (none) none.hidden = shown > 0;
            });
        })();

        // Grey "skeleton" of a group page: the same classes as the real header and ID badges, so every grey shape
        // sits exactly where the real names, numbers and buttons will appear. Used at the end of the opening transition.
        function accSkeleton(count, actions) {
            const bar = (w, h, r) => `<span class="acc-sk" style="width:${w}px;height:${h || 12}px;border-radius:${r || 6}px"></span>`;
            let cards = '';
            for (let i = 0; i < count; i++) {
                cards += `<div class="acc-badge acc-sk-badge"><div class="acc-badge-band acc-sk"></div><span class="acc-badge-av acc-sk"></span>`
                       + `<span class="acc-badge-name">${bar(90 + (i * 23) % 40, 14)}</span><span class="acc-badge-mail">${bar(120, 10)}</span><span class="acc-badge-phone">${bar(70, 10)}</span>`
                       + `<div class="acc-badge-stats"><div>${bar(30)}${bar(50, 8)}</div><div>${bar(50)}${bar(50, 8)}</div></div>`
                       + (actions ? `<div class="acc-badge-actions">${bar(0, 32, 99).replace('width:0px', 'flex:1')}${bar(70, 32, 99)}</div>` : '<div style="height:12px"></div>') + `</div>`;
            }
            return `<div class="acc-group-head acc-sk-head">${bar(92)}${bar(110, 30, 8)}${bar(100)}<span class="acc-search acc-sk"></span></div>`
                 + `<div class="acc-badges">${cards}</div>`;
        }
        function accMain() { return document.querySelector('.admin-main') || document.querySelector('main'); }
        function accSkelLayer(rows, actions) {   // skeleton positioned with the same padding as the page content
            const cs = getComputedStyle(accMain());
            const layer = document.createElement('div');
            layer.className = 'acc-sk-layer';
            Object.assign(layer.style, { paddingTop: cs.paddingTop, paddingLeft: cs.paddingLeft, paddingRight: cs.paddingRight });
            layer.innerHTML = accSkeleton(rows, actions);
            return layer;
        }

        // Choose a group: clicking a card makes it grow from where it sits until it fills the whole content
        // area (everything inside the top bar and side menu) while its colour fades from rust to the page
        // background. As it finishes, a skeleton of the group page fades in, and the group page then opens
        // under the same skeleton, which fades away to show the real rows - one continuous motion.
        (() => {
            const row = document.getElementById('acc-row');
            if (!row) return;
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            row.querySelectorAll('.acc-card').forEach(card => card.addEventListener('click', e => {
                if (reduce || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;   // new tab / no animation: just go
                e.preventDefault();
                const from = card.getBoundingClientRect();
                const m = accMain().getBoundingClientRect();
                const to = { left: Math.max(m.left, 0), top: Math.max(m.top, 0) };
                to.width = window.innerWidth - to.left;
                to.height = window.innerHeight - to.top;

                // A copy of the card, fixed on screen exactly where the card is.
                const fly = document.createElement('div');
                fly.className = 'acc-fly';
                fly.innerHTML = card.querySelector('.acc-kana').outerHTML + card.querySelector('.acc-text').outerHTML;
                Object.assign(fly.style, { left: from.left + 'px', top: from.top + 'px', width: from.width + 'px', height: from.height + 'px' });
                document.body.appendChild(fly);
                row.classList.add('is-opening');
                fly.getBoundingClientRect();   // start the transition from the card's position

                requestAnimationFrame(() => {
                    fly.classList.add('is-full');
                    Object.assign(fly.style, { left: to.left + 'px', top: to.top + 'px', width: to.width + 'px', height: to.height + 'px' });
                });

                // Skeleton badges: as many as the group has (from the card's count), up to 10.
                const count = parseInt(card.querySelector('.acc-count')?.textContent, 10);
                const rows = Math.max(1, Math.min(10, isNaN(count) ? 6 : count));
                setTimeout(() => {
                    const layer = accSkelLayer(rows, !/group=customers/i.test(card.href));   // customer badges have no role switch
                    layer.style.width = to.width + 'px';
                    fly.appendChild(layer);
                    requestAnimationFrame(() => layer.classList.add('is-in'));
                }, 220);

                try { sessionStorage.setItem('koma.acc.open', String(rows)); } catch (_) { }
                setTimeout(() => { location.href = card.href; }, 320);
            }));
        })();

        // Arriving on a group page from the cards: start under a page-coloured panel holding the same skeleton,
        // keep it for a moment (so it never just flickers), then fade it away to reveal the real page underneath.
        (() => {
            let rows = 0;
            try { rows = parseInt(sessionStorage.getItem('koma.acc.open'), 10) || 0; sessionStorage.removeItem('koma.acc.open'); } catch (_) { }
            if (!rows || document.getElementById('acc-row')) return;
            const m = accMain().getBoundingClientRect();
            const veil = document.createElement('div');
            veil.className = 'acc-veil';
            Object.assign(veil.style, { left: Math.max(m.left, 0) + 'px', top: Math.max(m.top, 0) + 'px' });
            const real = document.querySelectorAll('#acc-badges .acc-badge').length;
            const layer = accSkelLayer(real ? Math.min(real, 12) : rows, !!document.querySelector('#acc-badges .acc-badge-actions'));
            layer.classList.add('is-in');
            veil.appendChild(layer);
            document.body.appendChild(veil);
            setTimeout(() => veil.classList.add('is-gone'), 200);   // skeleton shows for at least 0.2 s
            setTimeout(() => veil.remove(), 450);
        })();

        // Account details: click (or Enter on) any badge and the panel slides in from the right.
        // The page address gets &id=... so the open customer can be bookmarked or shared; Esc closes,
        // ← → move to the previous / next customer (in the order shown, respecting the search box).
        (() => {
            const wrap = document.getElementById('cp-wrap');
            const grid = document.getElementById('acc-badges');
            if (!wrap || !grid) return;
            const veil = document.getElementById('cp-veil');
            const base = wrap.dataset.url;
            let current = null, req = 0, lastFocus = null, tab = null;
            const list = () => [...grid.querySelectorAll('.acc-badge[data-id]')].filter(b => !b.hidden);
            const setUrl = id => {
                const u = new URL(location.href);
                if (id) u.searchParams.set('id', id); else u.searchParams.delete('id');
                history.replaceState(null, '', u);
            };
            const sk = (w, h) => `<span class="cp-sk" style="display:block;width:${w};height:${h}px;margin-bottom:10px"></span>`;
            const loading = `<aside class="cp"><div class="cp-head"><div class="cp-band"></div>`
                + `<div style="padding:16px 24px">${sk('55%', 26)}${sk('35%', 12)}${sk('80%', 30)}</div></div>`
                + `<div class="cp-body" style="padding-top:18px">${sk('100%', 72)}${sk('40%', 18)}${sk('100%', 64)}${sk('100%', 64)}${sk('40%', 18)}${sk('100%', 120)}</div></aside>`;

            async function open(id) {
                const n = ++req;
                current = id;
                setUrl(id);
                if (!wrap.classList.contains('is-open')) {
                    lastFocus = document.activeElement;
                    wrap.innerHTML = loading;
                    veil.hidden = false;
                    document.documentElement.classList.add('cp-noscroll');
                    requestAnimationFrame(() => { veil.classList.add('is-in'); wrap.classList.add('is-open'); });
                } else {
                    wrap.querySelector('[data-cp-body]')?.classList.add('is-dim');
                }
                try {
                    const r = await fetch(base + '&id=' + encodeURIComponent(id), { credentials: 'same-origin' });
                    if (!r.ok) throw new Error(r.status);
                    const html = await r.text();
                    if (n !== req) return;   // a newer request has started
                    wrap.innerHTML = html;
                    bind();
                } catch (_) {
                    if (n !== req) return;
                    wrap.innerHTML = `<aside class="cp"><div class="cp-head"><div class="cp-band">`
                        + `<div class="cp-band-tools"><button type="button" class="cp-close" data-cp-close aria-label="Close">×</button></div></div></div>`
                        + `<div class="cp-body"><p class="cp-empty" style="padding-top:20px">Couldn't load this account. Try again.</p></div></aside>`;
                    wrap.querySelector('[data-cp-close]').addEventListener('click', close);
                }
            }

            function close() {
                req++;
                current = null;
                setUrl(null);
                wrap.classList.remove('is-open');
                veil.classList.remove('is-in');
                document.documentElement.classList.remove('cp-noscroll');
                setTimeout(() => { if (!current) { wrap.innerHTML = ''; veil.hidden = true; } }, 300);
                if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
            }

            function step(d) {
                const all = list();
                const i = all.findIndex(b => b.dataset.id === current);
                if (i < 0 || all.length < 2) return;
                const next = all[(i + d + all.length) % all.length];
                next.scrollIntoView({ block: 'nearest' });
                open(next.dataset.id);
            }

            function bind() {
                const all = list();
                const i = all.findIndex(b => b.dataset.id === current);
                const pos = wrap.querySelector('[data-cp-pos]');
                if (pos) pos.textContent = i >= 0 ? `${i + 1} of ${all.length}` : '';
                wrap.querySelector('[data-cp-close]')?.addEventListener('click', close);
                wrap.querySelector('[data-cp-prev]')?.addEventListener('click', () => step(-1));
                wrap.querySelector('[data-cp-next]')?.addEventListener('click', () => step(1));

                // Icon tabs: one list at a time. The last tab used stays open when moving to the next customer.
                const tabs = [...wrap.querySelectorAll('[data-cp-tab]')];
                const show = id => tabs.forEach(t => {
                    const on = t.dataset.cpTab === id;
                    t.classList.toggle('is-on', on);
                    t.setAttribute('aria-selected', on);
                    const pane = wrap.querySelector('#' + t.dataset.cpTab);
                    if (pane) pane.hidden = !on;
                });
                tabs.forEach(t => t.addEventListener('click', () => { tab = t.dataset.cpTab; show(tab); }));
                if (tab && wrap.querySelector('#' + tab)) show(tab);

                // Lock / unlock asks first.
                wrap.querySelector('form.js-cp-lock')?.addEventListener('submit', e => {
                    const f = e.currentTarget;
                    if (!window.KomaConfirm) return;
                    e.preventDefault();
                    const locking = f.dataset.lock === '1';
                    KomaConfirm.open({
                        tone: locking ? 'danger' : 'warn', icon: 'shield',
                        title: locking ? `Lock ${f.dataset.name}'s account?` : `Unlock ${f.dataset.name}'s account?`,
                        text: locking ? 'They won\'t be able to sign in until you unlock it.' : 'They will be able to sign in again.',
                        ok: locking ? 'Lock' : 'Unlock', no: 'Cancel',
                        onOk: () => HTMLFormElement.prototype.submit.call(f)
                    });
                });
                // Staff / Admin card: role switch asks first (you can't change your own; the server checks too).
                const roleForm = wrap.querySelector('form.js-role-form');
                roleForm?.querySelectorAll('[data-role]').forEach(btn => btn.addEventListener('click', () => {
                    roleForm.querySelector('input[name="role"]').value = btn.dataset.role;
                }));
                roleForm?.addEventListener('submit', e => {
                    const role = roleForm.querySelector('input[name="role"]').value;
                    if (role === roleForm.dataset.current) { e.preventDefault(); return; }
                    if (!window.KomaConfirm) return;
                    e.preventDefault();
                    const toAdmin = role === 'Administrator';
                    KomaConfirm.open({
                        tone: 'warn', icon: 'shield',
                        title: toAdmin ? `Make ${roleForm.dataset.email} an Admin?` : `Change ${roleForm.dataset.email} to Staff?`,
                        text: toAdmin ? 'Admins can change everything, including accounts.' : 'They will lose access to admin-only pages.',
                        ok: 'Confirm', no: 'Cancel',
                        onOk: () => HTMLFormElement.prototype.submit.call(roleForm)
                    });
                });

                // Password reset link: made on the server, shown here to copy and pass on.
                const resetForm = wrap.querySelector('form.js-cp-reset');
                resetForm?.addEventListener('submit', async e => {
                    e.preventDefault();
                    const out = wrap.querySelector('.cp-reset-out');
                    const btn = resetForm.querySelector('button');
                    btn.disabled = true;
                    try {
                        const r = await fetch(resetForm.action, { method: 'POST', body: new FormData(resetForm), credentials: 'same-origin' });
                        if (!r.ok) throw new Error(r.status);
                        const data = await r.json();
                        out.querySelector('input').value = data.url;
                        out.hidden = false;
                        out.querySelector('input').select();
                    } catch (_) {
                        btn.textContent = 'Couldn\'t make a link. Try again.';
                    } finally { btn.disabled = false; }
                });
                wrap.querySelector('[data-cp-copy]')?.addEventListener('click', async e => {
                    const input = wrap.querySelector('.cp-reset-out input');
                    try { await navigator.clipboard.writeText(input.value); } catch (_) { input.select(); document.execCommand('copy'); }
                    e.currentTarget.textContent = 'Copied';
                });

                wrap.querySelector('[data-cp-close]')?.focus({ preventScroll: true });
            }

            grid.addEventListener('click', e => {
                const b = e.target.closest('.acc-badge[data-id]');
                if (b && !e.target.closest('a, button, select, input, form')) open(b.dataset.id);
            });
            grid.addEventListener('keydown', e => {
                const b = e.target.closest('.acc-badge[data-id]');
                if (b && e.target === b && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(b.dataset.id); }
            });
            veil.addEventListener('click', close);
            document.addEventListener('keydown', e => {
                if (!current) return;
                if (document.querySelector('dialog[open], .koma-confirm.is-open')) return;   // a confirm pop-up is up
                const typing = /^(INPUT|SELECT|TEXTAREA)$/.test(e.target.tagName);
                if (e.key === 'Escape') { e.preventDefault(); close(); }
                else if (!typing && e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
                else if (!typing && e.key === 'ArrowRight') { e.preventDefault(); step(1); }
            });

            const startId = new URLSearchParams(location.search).get('id');
            if (startId) open(startId);
        })();
        // Staff schedule: click a cell, pick a shift / Leave / Off. Saved straight away and the table is redrawn
        // (?handler=Shift returns _Schedule.cshtml). Esc or a click elsewhere closes the menu.
        (() => {
            const wrap = document.getElementById('sc-wrap');
            if (!wrap) return;
            let cell = null;
            const menu = () => wrap.querySelector('.sc-menu');
            const hide = () => { const m = menu(); if (m) m.hidden = true; cell?.classList.remove('is-open'); cell = null; };

            wrap.addEventListener('click', async e => {
                const c = e.target.closest('.sc-cell');
                const opt = e.target.closest('.sc-menu button');
                if (c) {
                    if (cell === c) { hide(); return; }
                    hide();
                    cell = c;
                    c.classList.add('is-open');
                    const m = menu(), box = wrap.querySelector('.sc').getBoundingClientRect(), r = c.getBoundingClientRect();
                    m.hidden = false;
                    m.style.left = Math.max(0, Math.min(r.left - box.left, box.width - m.offsetWidth)) + 'px';
                    m.style.top = (r.bottom - box.top + 6) + 'px';
                    m.querySelectorAll('button').forEach(b => b.classList.toggle('is-on', b.dataset.value === c.dataset.value));
                    (m.querySelector('.is-on') || m.querySelector('button')).focus({ preventScroll: true });
                    return;
                }
                if (opt && cell) {
                    const sc = wrap.querySelector('.sc'), target = cell, value = opt.dataset.value;
                    hide();
                    if (value === target.dataset.value) { target.focus(); return; }
                    const fd = new FormData();
                    fd.append('userId', target.dataset.user);
                    fd.append('date', target.dataset.date);
                    fd.append('value', value);
                    fd.append('m', sc.dataset.m);
                    fd.append('__RequestVerificationToken', sc.querySelector('input[name="__RequestVerificationToken"]').value);
                    sc.classList.add('is-busy');
                    try {
                        const r = await fetch(sc.dataset.post, { method: 'POST', body: fd, credentials: 'same-origin' });
                        if (!r.ok) throw new Error(r.status);
                        wrap.innerHTML = await r.text();
                        initStrip();
                        wrap.querySelector(`.sc-cell[data-user="${target.dataset.user}"][data-date="${target.dataset.date}"]`)?.focus({ preventScroll: true });
                    } catch (_) {
                        sc.classList.remove('is-busy');
                        target.title = 'Couldn\'t save. Try again.';
                    }
                }
            });

            // Day strip slider: drag the navy window along the month; it snaps to whole weeks (Mon-Sun)
            // and opens that week when you let go. Click a day or use ← → on the strip as well.
            function initStrip() {
                const strip = wrap.querySelector('.sc-days');
                if (!strip) return;
                const win = strip.querySelector('.sc-win');
                const days = [...strip.querySelectorAll('.sc-day')];
                const startWk = days.find(d => d.classList.contains('is-in'))?.dataset.wk;
                let wk = startWk, dragging = false, moved = false, x0 = 0;
                const weeks = [...new Set(days.map(d => d.dataset.wk))];
                const show = key => {
                    wk = key;
                    const sel = days.filter(d => d.dataset.wk === key);
                    days.forEach(d => d.classList.toggle('is-in', d.dataset.wk === key));
                    if (!sel.length) { win.style.width = '0'; return; }
                    const a = sel[0], b = sel[sel.length - 1];
                    win.style.left = a.offsetLeft + 'px';
                    win.style.width = (b.offsetLeft + b.offsetWidth - a.offsetLeft) + 'px';
                };
                const go = key => {
                    const d = days.find(x => x.dataset.wk === key);
                    if (key && d && key !== startWk) location.href = d.href; else show(startWk);
                };
                const dayAt = x => days.find(d => { const r = d.getBoundingClientRect(); return x >= r.left && x < r.right; })
                    || (x < days[0].getBoundingClientRect().left ? days[0] : days[days.length - 1]);
                show(startWk);
                requestAnimationFrame(() => strip.classList.add('is-ready'));
                window.addEventListener('resize', () => show(wk));

                strip.addEventListener('pointerdown', e => {
                    if (e.button !== 0) return;
                    e.preventDefault();
                    dragging = true; moved = false; x0 = e.clientX;
                    strip.setPointerCapture(e.pointerId);
                    strip.classList.add('is-drag');
                    show(dayAt(e.clientX).dataset.wk);
                });
                strip.addEventListener('pointermove', e => {
                    if (!dragging) return;
                    if (Math.abs(e.clientX - x0) > 3) moved = true;
                    show(dayAt(e.clientX).dataset.wk);
                });
                const end = () => { if (!dragging) return; dragging = false; strip.classList.remove('is-drag'); go(wk); };
                strip.addEventListener('pointerup', end);
                strip.addEventListener('pointercancel', () => { dragging = false; strip.classList.remove('is-drag'); show(startWk); });
                strip.addEventListener('click', e => e.preventDefault());   // navigation happens on pointerup
                strip.addEventListener('keydown', e => {
                    const i = weeks.indexOf(wk);
                    if (e.key === 'ArrowLeft' && i > 0) { e.preventDefault(); show(weeks[i - 1]); go(wk); }
                    else if (e.key === 'ArrowRight' && i < weeks.length - 1) { e.preventDefault(); show(weeks[i + 1]); go(wk); }
                });
            }
            initStrip();
            document.addEventListener('click', e => { if (cell && !e.target.closest('.sc-menu, .sc-cell')) hide(); });
            document.addEventListener('keydown', e => { if (e.key === 'Escape' && cell) { const c = cell; hide(); c.focus(); } });

            // Copy last week asks first (it replaces this week's shifts).
            wrap.addEventListener('submit', e => {
                const f = e.target.closest('form.js-sc-copy');
                if (!f || !window.KomaConfirm) return;
                e.preventDefault();
                KomaConfirm.open({
                    tone: 'warn', icon: 'shield',
                    title: 'Copy last week\'s shifts?',
                    text: 'This week\'s shifts are replaced. Leave isn\'t copied.',
                    ok: 'Copy', no: 'Cancel',
                    onOk: () => HTMLFormElement.prototype.submit.call(f)
                });
            });
        })();
    </script>
}
