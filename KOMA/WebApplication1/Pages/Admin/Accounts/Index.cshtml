@page
@model KOMA.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = "Accounts & Roles";
}

<h1>Accounts &amp; Roles</h1>
<div asp-validation-summary="All" class="text-danger"></div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table table-striped">
    <thead><tr><th>Email</th><th>Current Role</th><th>Change role</th></tr></thead>
    <tbody>
    @foreach (var account in Model.Accounts)
    {
        <tr>
            <td>@account.Email</td>
            <td>@account.Role</td>
            <td>
                <form method="post" class="d-flex gap-2 js-role-form" data-email="@account.Email" data-current="@account.Role">
                    <input type="hidden" name="userId" value="@account.UserId" />
                    <select name="role" class="form-select form-select-sm">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            @if (role == account.Role)
                            {
                                <option value="@role" selected>@role</option>
                            }
                            else
                            {
                                <option value="@role">@role</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script>
        // Ask before changing someone's role (shared KOMA pop-up, js/koma-confirm.js). Only when the role really changes.
        document.querySelectorAll('form.js-role-form').forEach(form => form.addEventListener('submit', e => {
            const role = form.querySelector('select[name="role"]').value;
            const current = form.dataset.current, who = form.dataset.email;
            if (role === current || !window.KomaConfirm) return;
            e.preventDefault();
            const toAdmin = role === 'Administrator', fromAdmin = current === 'Administrator';
            KomaConfirm.open({
                tone: 'warn', icon: 'shield',
                title: toAdmin ? `Make ${who} an Administrator?` : `Change ${who} to ${role}?`,
                ok: 'Confirm', no: 'Cancel',
                onOk: () => HTMLFormElement.prototype.submit.call(form)
            });
        }));
    </script>
}
