@page
@model KOMA.Pages.Admin.Feedback.IndexModel
@{ ViewData["Title"] = "Feedback"; }
<link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
<h1>Feedback</h1><p>Select a card to read the full feedback.</p>
@if (Model.Feedbacks.Count == 0) { <p>No feedback yet.</p> }
<div class="feedback-cards">
@foreach (var feedback in Model.Feedbacks)
{
    <div><button type="button" class="feedback-card" data-feedback-open="feedback-@feedback.Id">
        <strong>@feedback.Name</strong><p aria-label="@feedback.Rating out of 5 stars">@(new string('★', feedback.Rating))@(new string('☆', 5 - feedback.Rating))</p>
        <small>@feedback.CreatedAtUtc.AddHours(8).ToString("dd MMM yyyy, HH:mm") · @feedback.Source</small>
        <p class="feedback-comment">@(feedback.Comment.Length > 120 ? feedback.Comment[..120] + "…" : feedback.Comment)</p>
    </button></div>
    <dialog id="feedback-@feedback.Id" class="feedback-dialog" aria-labelledby="feedback-title-@feedback.Id">
        <button type="button" class="feedback-close" data-feedback-close>Close</button>
        <h2 id="feedback-title-@feedback.Id">Feedback from @feedback.Name</h2>
        <p>@feedback.Rating / 5 stars · @feedback.Source</p>
        <p>@feedback.CreatedAtUtc.AddHours(8).ToString("dd MMM yyyy, HH:mm") (Malaysia)</p>
        @if (feedback.UpdatedAtUtc.HasValue) { <p>Updated: @feedback.UpdatedAtUtc.Value.AddHours(8).ToString("dd MMM yyyy, HH:mm")</p> }
        @if (!string.IsNullOrWhiteSpace(feedback.Email)) { <p>Email: @feedback.Email</p> }
        @if (feedback.ReservationId.HasValue) { <p>Reservation R-@feedback.ReservationId.Value.ToString("D5")</p> }
        @if (feedback.TableServiceSession != null) { <p>Table @feedback.TableServiceSession.RestaurantTable.TableNumber · Visit @feedback.TableServiceSession.StartTime.ToString("dd MMM yyyy, HH:mm")</p> }
        <p class="feedback-comment">@feedback.Comment</p>
    </dialog>
}
</div>
<nav class="d-flex gap-3 mt-4" aria-label="Feedback pages">
@if (Model.CurrentPage > 1) { <a asp-route-p="@(Model.CurrentPage - 1)">Previous</a> }
@if (Model.HasMore) { <a asp-route-p="@(Model.CurrentPage + 1)">Next</a> }
</nav>
<script src="~/js/feedback.js" asp-append-version="true" defer></script>
