@page "{id:int}"
@model KOMA.Pages.Admin.DiningAreas.DeleteModel
@{
    ViewData["Title"] = "Delete Dining Area";
}

<h1>Delete Dining Area</h1>

<div class="alert alert-warning">
    Are you sure you want to delete <strong>@Model.DiningArea.Name</strong>? This cannot be undone.
</div>

<form method="post">
    <input type="hidden" asp-for="DiningArea.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>
