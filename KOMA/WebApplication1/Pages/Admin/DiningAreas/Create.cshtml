@page
@model KOMA.Pages.Admin.DiningAreas.CreateModel
@{
    ViewData["Title"] = "New Dining Area";
}

<h1>New Dining Area</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DiningArea.Name" class="form-label"></label>
        <input asp-for="DiningArea.Name" class="form-control" />
        <span asp-validation-for="DiningArea.Name" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DiningArea.Zone" class="form-label"></label>
            <select asp-for="DiningArea.Zone" class="form-select"
                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(KOMA.Models.DiningArea.ZoneOptions))"></select>
            <span asp-validation-for="DiningArea.Zone" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DiningArea.Floor" class="form-label"></label>
            <select asp-for="DiningArea.Floor" class="form-select"
                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(KOMA.Models.DiningArea.FloorOptions))"></select>
            <span asp-validation-for="DiningArea.Floor" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="DiningArea.Description" class="form-label"></label>
        <textarea asp-for="DiningArea.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-check mb-3">
        <input asp-for="DiningArea.IsActive" class="form-check-input" />
        <label asp-for="DiningArea.IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>
