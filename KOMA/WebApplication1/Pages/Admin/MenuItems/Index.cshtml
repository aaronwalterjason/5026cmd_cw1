@page
@model KOMA.Pages.Admin.MenuItems.IndexModel
@{
    ViewData["Title"] = "Menu Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Menu Items</h1>
    <a class="btn btn-primary" asp-page="./Create">+ New menu item</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Available</th><th>Homepage</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td>@i.Name</td>
            <td>@i.MenuCategory?.Name</td>
            <td>@i.Price.ToString("C")</td>
            <td>@(i.IsAvailable ? "Yes" : "No")</td>
            <td>@(i.IsRecommended ? "Recommended" : "") @(i.IsSeasonal ? "Seasonal" : "")</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-page="./Edit" asp-route-id="@i.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@i.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

