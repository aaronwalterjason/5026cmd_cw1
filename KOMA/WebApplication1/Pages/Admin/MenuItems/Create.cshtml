@page
@model KOMA.Pages.Admin.MenuItems.CreateModel
@{
    ViewData["Title"] = "New Menu Item";
}

<h1>New Menu Item</h1>

<form method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Item.Name" class="form-label"></label>
        <input asp-for="Item.Name" class="form-control" />
        <span asp-validation-for="Item.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Item.MenuCategoryId" class="form-label">Category</label>
        <select asp-for="Item.MenuCategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">-- select --</option>
        </select>
        <span asp-validation-for="Item.MenuCategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Item.Description" class="form-label"></label>
        <textarea asp-for="Item.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Item.Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">RM</span>
            <input asp-for="Item.Price" type="number" step="any" min="0" inputmode="decimal"
                   class="form-control js-price" placeholder="e.g. 12.90"
                   value="@(Model.Item.Price > 0 ? Model.Item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        </div>
        <span asp-validation-for="Item.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Photo" class="form-label">Food photo</label>
        <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
        <span asp-validation-for="Photo" class="text-danger"></span>
        <p class="form-text">JPG, PNG or WebP, up to 5 MB. Leave blank to keep the current photo.</p>
        @if (!string.IsNullOrEmpty(Model.Item.ImageUrl))
        {
            <img src="@Model.Item.ImageUrl" alt="@Model.Item.Name" style="width:180px;height:120px;object-fit:cover" />
        }
    </div>

    <div class="form-check mb-3">
        <input asp-for="Item.IsAvailable" class="form-check-input" />
        <label asp-for="Item.IsAvailable" class="form-check-label"></label>
    </div>

    <fieldset class="mb-3">
        <legend class="fs-6">Show on the homepage</legend>
        <div class="form-check">
            <input asp-for="Item.IsRecommended" class="form-check-input" />
            <label asp-for="Item.IsRecommended" class="form-check-label">Recommended</label>
        </div>
        <div class="form-check">
            <input asp-for="Item.IsSeasonal" class="form-check-input" />
            <label asp-for="Item.IsSeasonal" class="form-check-label">Seasonal special</label>
        </div>
        <p class="form-text">Select either or both. Only available items in active categories appear. Prices are not shown on the homepage.</p>
    </fieldset>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <script>
        // Tidy the price to 2 decimal places when the admin leaves the box (12.9 -> 12.90).
        document.querySelectorAll('.js-price').forEach(function (box) {
            box.addEventListener('blur', function () {
                var v = parseFloat(box.value.replace(',', '.'));
                if (!isNaN(v)) box.value = v.toFixed(2);
            });
        });
    </script>
}
