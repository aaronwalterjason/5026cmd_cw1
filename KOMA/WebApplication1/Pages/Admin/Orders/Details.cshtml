@page "{id:int}"
@model KOMA.Pages.Admin.Orders.DetailsModel
@using KOMA.Pages.Admin.Orders
@{
    var o = Model.Order;
    ViewData["Title"] = o.OrderNumber;
}

<a asp-page="./Index" class="btn btn-link px-0">&larr; Back to orders</a>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@o.OrderNumber</h1>
    <span class="badge fs-6 @IndexModel.BadgeClass(o.Status)">@o.Status.DisplayName()</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <dl class="row mb-0">
                <dt class="col-5">Order type</dt>
                <dd class="col-7"><span class="badge @IndexModel.TypeBadgeClass(o.OrderType)">@IndexModel.TypeIcon(o.OrderType) @o.OrderType.DisplayName()</span></dd>
                <dt class="col-5">Customer</dt>
                <dd class="col-7">@IndexModel.CustomerName(o)
                    @if (o.Customer?.Email is not null) { <div class="small text-muted">@o.Customer.Email</div> }
                    else { <div class="small text-muted">No account</div> }
                </dd>
                <dt class="col-5">Table</dt>
                <dd class="col-7">@(o.RestaurantTable is null ? "—" : $"{o.RestaurantTable.TableNumber} ({o.RestaurantTable.DiningArea?.Name})")</dd>
                <dt class="col-5">Ordered at</dt>
                <dd class="col-7 mb-0">@o.OrderedAt.ToString("dd MMM yyyy, h:mm tt")</dd>
            </dl>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <dl class="row mb-0">
                <dt class="col-5">Payment</dt>
                <dd class="col-7">@o.PaymentStatus.DisplayName()</dd>
                <dt class="col-5">Method</dt>
                <dd class="col-7">@(o.PaymentMethod?.DisplayName() ?? "—")</dd>
                <dt class="col-5">Paid at</dt>
                <dd class="col-7 mb-0">@(o.PaidAt?.ToString("dd MMM yyyy, h:mm tt") ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Subtotal</th></tr>
    </thead>
    <tbody>
    @foreach (var i in o.Items)
    {
        <tr>
            <td>@(i.MenuItem?.Name ?? "(removed item)")</td>
            <td class="text-end">@i.Quantity</td>
            <td class="text-end">RM @i.UnitPrice.ToString("N2")</td>
            <td class="text-end">RM @i.LineTotal.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr class="fw-semibold">
            <td colspan="3" class="text-end">Total</td>
            <td class="text-end">RM @o.TotalAmount.ToString("N2")</td>
        </tr>
    </tfoot>
</table>

@if (!string.IsNullOrWhiteSpace(o.Notes))
{
    <p><strong>Notes:</strong> @o.Notes</p>
}
