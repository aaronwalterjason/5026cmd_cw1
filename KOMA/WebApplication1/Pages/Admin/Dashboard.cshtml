@page
@model KOMA.Pages.Admin.DashboardModel
@using System.Globalization
@{
    ViewData["Title"] = "Today";
    var inv = CultureInfo.InvariantCulture;
    string Pct(double v, double total) => (total <= 0 ? 0 : v / total * 100).ToString("0.###", inv) + "%";
    string Num(double v) => v.ToString("0.###", inv);
    const double Ring = 163.36;   // circumference of the r=26 ring
    var seatedDash = (Model.SeatedShare * Ring).ToString("0.##", inv);
    var payDash = (Model.PaymentShare * Ring).ToString("0.##", inv);
    var payOffset = (-Model.SeatedShare * Ring).ToString("0.##", inv);
    var all = Model.OrderTypeStats.First();
}

@* ================= Header: date tile, open status, alerts chip, live time ================= *@
<div class="dash-head">
    <div class="dash-cal" aria-hidden="true">
        <span class="dash-cal-m">@Model.Now.ToString("MMM").ToUpperInvariant()</span>
        <span class="dash-cal-d">@Model.Now.Day</span>
        <span class="dash-cal-w">@Model.Now.ToString("ddd").ToUpperInvariant()</span>
    </div>
    <div>
        <h1 class="mb-0">Today</h1>
        <div class="dash-status @(Model.IsOpen ? "is-open" : "is-closed")">
            ● @Model.OpenText
            @if (Model.NextBooking is not null)
            {
                <span class="dash-muted">· next booking @Model.NextBooking.StartTime.ToString("h:mm tt")</span>
            }
        </div>
    </div>
    @if (Model.AlertCount > 0)
    {
        <a href="#dash-alerts" class="dash-alert-chip" title="Jump to Alerts">
            <span>@Model.AlertCount alert@(Model.AlertCount == 1 ? "" : "s")</span>
            <span class="dash-chip-parts">
                @if (Model.SlowOrders.Any()) { <span title="Slow orders">⏱ @Model.SlowOrders.Count</span> }
                @if (Model.UnpaidTables.Any()) { <span title="Tables waiting to pay">RM @Model.UnpaidTables.Count</span> }
                @if (Model.SoldOut.Any()) { <span title="Sold-out dishes">☕ @Model.SoldOut.Count</span> }
            </span>
        </a>
    }
    <span class="dash-live @(Model.AlertCount > 0 ? "" : "ms-auto")" title="Refreshes every minute">
        <span class="dash-live-dot"></span>@Model.Now.ToString("h:mm tt")
    </span>
</div>

<div class="dash-grid">
    <div class="dash-left">
        <div class="dash-kpis">
            @* ================= Sales (whole card opens Revenue › Day) ================= *@
            <a asp-page="/Admin/Revenue/Index" asp-route-period="day" asp-route-date="@Model.Now.ToString("yyyy-MM-dd")"
               class="dash-card dash-sales" title="Open Revenue by hour for @Model.Now.ToString("d MMM")">
                <span class="dash-title-row"><span class="dash-title">Sales</span><span class="dash-title-sub">@Model.Now.ToString("ddd d MMM")</span></span>
                <span class="dash-big"><small>RM</small>@Model.SalesToday.ToString("N2")</span>
                @foreach (var c in Model.SalesComparisons)
                {
                    <span class="dash-cmp">
                        <span class="dash-cmp-day">@c.Day.ToString("ddd d MMM")</span>
                        <span class="dash-cmp-amt">RM @c.Amount.ToString("N2")</span>
                        @if (c.ChangePercent is double pct)
                        {
                            <span class="dash-pill @(pct >= 0 ? "is-up" : "is-down")">@(pct >= 0 ? "↑" : "↓") @Math.Abs(Math.Round(pct))%</span>
                        }
                        else
                        {
                            <span class="dash-pill">—</span>
                        }
                    </span>
                }
                <span class="dash-foot-note">Compared up to @Model.Now.ToString("h:mm tt") on each day</span>
            </a>

            @* ================= Total orders (tabs filter by order type) ================= *@
            @* Whole card opens the Orders page for today (filtered by the chosen type); the tabs only filter the card. *@
            <div class="dash-card dash-orders" id="dash-orders" role="link" tabindex="0" title="Open today's orders"
                 data-href="@Url.Page("/Admin/Orders/Index", new { from = Model.Now.ToString("yyyy-MM-dd"), to = Model.Now.ToString("yyyy-MM-dd") })">
                <div class="dash-orders-top">
                    <span class="dash-title">Total orders</span>
                    <span class="dash-pill" id="dash-ord-cmp"></span>
                </div>
                <div class="dash-orders-num"><b id="dash-ord-num">@all.Count</b><span class="dash-muted">avg <strong id="dash-ord-avg">RM @all.Average.ToString("N2")</strong></span></div>
                <div class="dash-seg" role="tablist" aria-label="Order type">
                    @foreach (var s in Model.OrderTypeStats)
                    {
                        <button type="button" role="tab" class="@(s.Key == "all" ? "is-on" : "")" aria-selected="@(s.Key == "all" ? "true" : "false")"
                                data-type="@(s.Key == "all" ? "" : s.Key)" data-count="@s.Count" data-avg="@s.Average.ToString("N2")" data-last="@s.LastWeek">
                            @s.Label <b>@s.Count</b>
                        </button>
                    }
                </div>
                <span class="dash-hint">Tap a type to filter the number and average</span>
                <div class="dash-orders-foot">
                    @if (string.IsNullOrEmpty(Model.BusiestType))
                    {
                        <span>No orders yet today.</span>
                    }
                    else
                    {
                        <span>Busiest today: <strong>@Model.BusiestType · @Model.BusiestShare%</strong></span>
                    }
                </div>
            </div>
        </div>

        @* ================= Live seating ================= *@
        <div class="dash-card dash-seat">
            <div class="dash-seat-head">
                <span class="dash-seat-sum">
                    <span class="dash-title">Live seating</span>
                    <svg class="kpi-ring" width="40" height="40" viewBox="0 0 64 64" role="img" aria-label="@Model.OccupiedPercent percent of tables in use">
                        <circle cx="32" cy="32" r="26" fill="none" stroke="#eee7db" stroke-width="7"></circle>
                        @if (Model.SeatedShare > 0)
                        {
                            <circle cx="32" cy="32" r="26" fill="none" stroke="#263b49" stroke-width="7" stroke-dasharray="@seatedDash @Ring.ToString(inv)" transform="rotate(-90 32 32)"></circle>
                        }
                        @if (Model.PaymentShare > 0)
                        {
                            <circle cx="32" cy="32" r="26" fill="none" stroke="#974535" stroke-width="7" stroke-dasharray="@payDash @Ring.ToString(inv)" stroke-dashoffset="@payOffset" transform="rotate(-90 32 32)"></circle>
                        }
                        <text x="32" y="37" text-anchor="middle" font-family="Georgia, serif" font-size="15" fill="#22343d">@Model.OccupiedPercent%</text>
                    </svg>
                    <span><strong>@Model.TablesOccupied / @Model.TablesTotal</strong> tables · @(Model.TablesOccupied - Model.TablesAwaitingPayment) eating · <span class="dash-rust">@Model.TablesAwaitingPayment paying</span></span>
                </span>
                <span class="dash-key">
                    <span><span class="live-key live-free"></span>Free</span>
                    <span><span class="live-key live-occupied"></span>Seated</span>
                    <span><span class="live-key live-payment"></span>Awaiting payment</span>
                    <span><span class="live-key live-inactive"></span>Closed</span>
                </span>
            </div>

            @if (!Model.Floors.Any())
            {
                <partial name="_Empty" model='new EmptyState("floor", "No floor layouts yet", "Create a floor to see live seating here.", "Create a floor", Url.Page("/Admin/Layouts/Create"), true)' />
            }
            else
            {
                @* Floor pills: seated count, and a rust dot per table waiting to pay on that floor. *@
                <div class="dash-floors" role="tablist">
                    @for (int i = 0; i < Model.Floors.Count; i++)
                    {
                        var f = Model.Floors[i];
                        var paying = Model.PayingOn(f);
                        <button class="dash-floor @(i == 0 ? "active" : "")" id="floor-tab-@f.Id" data-bs-toggle="tab"
                                data-bs-target="#floor-pane-@f.Id" type="button" role="tab" data-floor-id="@f.Id"
                                title="@paying table@(paying == 1 ? "" : "s") waiting to pay">
                            @f.Name <span class="dash-floor-n">@Model.SeatedOn(f)</span>
                            @for (int d = 0; d < Math.Min(paying, 4); d++) { <span class="dash-dot"></span> }
                        </button>
                    }
                </div>
                <div class="tab-content">
                    @for (int i = 0; i < Model.Floors.Count; i++)
                    {
                        var f = Model.Floors[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="floor-pane-@f.Id" role="tabpanel">
                            @if (!f.DiningAreas.Any())
                            {
                                <p class="dash-muted small mb-0">Nothing drawn on this floor yet. <a asp-page="/Admin/Layouts/Designer" asp-route-id="@f.Id">Open the layout</a>.</p>
                            }
                            <div class="lay-preview live-map" style="aspect-ratio:@f.Width / @f.Height;width:min(100%, calc(46vh * @f.Width / @f.Height));margin-inline:auto" data-floor-w="@f.Width" data-floor-h="@f.Height">
                                @foreach (var a in f.DiningAreas)
                                {
                                    <div class="lay-preview-area @KOMA.Pages.Admin.Layouts.IndexModel.ZoneClass(a.Zone) @(a.IsActive ? "" : "is-closed")"
                                         style="left:@Pct(a.LayoutX, f.Width);top:@Pct(a.LayoutY, f.Height);width:@Pct(a.LayoutWidth, f.Width);height:@Pct(a.LayoutHeight, f.Height)">
                                        <span class="live-area-name">@a.Name@(a.IsActive ? " · " + Model.AreaUse(a) : "")</span>
                                    </div>
                                }
                                @foreach (var a in f.DiningAreas)
                                {
                                    foreach (var t in a.Tables)
                                    {
                                        var state = Model.StateOf(t, a);
                                        Model.SeatedOrderByTable.TryGetValue(t.Id, out var o);
                                        var css = state switch
                                        {
                                            DashboardModel.SeatState.Occupied => "live-occupied",
                                            DashboardModel.SeatState.AwaitingPayment => "live-payment",
                                            DashboardModel.SeatState.Inactive => "live-inactive",
                                            _ => "live-free"
                                        };
                                        var tip = o is null
                                            ? $"Table {t.TableNumber} · {t.Capacity} seats · {(state == DashboardModel.SeatState.Inactive ? "closed" : "free")}"
                                            : $"Table {t.TableNumber} · {o.CustomerName} · {o.Status.DisplayName()} · seated {DashboardModel.Minutes(o.OrderedAt, Model.Now)} · RM {o.TotalAmount:N2}";
                                        var sub = o is null ? null : state == DashboardModel.SeatState.AwaitingPayment ? "RM" : DashboardModel.ShortMinutes(o.OrderedAt, Model.Now);
                                        var style = $"left:{Pct(t.LayoutX, f.Width)};top:{Pct(t.LayoutY, f.Height)};width:{Pct(t.LayoutWidth, f.Width)};height:{Pct(t.LayoutHeight, f.Height)}";
                                        @* Clicking a table opens the popup below (filled from TablePopupJson). *@
                                        <button type="button" class="lay-preview-table live-table @css @(t.Shape == TableShape.Round ? "is-round" : "")"
                                                title="@tip" aria-label="@tip" style="@style" data-table-id="@t.Id"
                                                data-x="@Num(t.LayoutX)" data-y="@Num(t.LayoutY)" data-w="@Num(t.LayoutWidth)" data-h="@Num(t.LayoutHeight)"
                                                data-shape="@t.Shape" data-capacity="@t.Capacity"><span class="dash-tnum">@(t.TableNumber)@if (sub is not null) {<small>@sub</small>}</span></button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="dash-right">
        @* ================= Alerts ================= *@
        <div class="dash-card dash-alerts" id="dash-alerts">
            <div class="dash-card-head"><span class="dash-title">Alerts</span><span class="dash-count @(Model.AlertCount == 0 ? "is-zero" : "")">@Model.AlertCount</span></div>
            @if (Model.AlertCount == 0)
            {
                <div class="dash-allclear"><span class="dash-tick">✓</span><strong>All clear</strong><span class="dash-muted">No one is waiting. Orders and payments are on time.</span></div>
            }
            else
            {
                @if (Model.SoldOut.Any())
                {
                    <div class="dash-grp"><span>Sold out</span><span>@Model.SoldOut.Count</span></div>
                    <div class="dash-chips">
                        @foreach (var m in Model.SoldOut.Take(6)) { <span>@m.Name</span> }
                        @if (Model.SoldOut.Count > 6) { <span>+@(Model.SoldOut.Count - 6)</span> }
                        <a class="koma-go" asp-page="/Admin/MenuItems/Index">Menu<span class="koma-go-disc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
                    </div>
                }
                @if (Model.SlowOrders.Any())
                {
                    <div class="dash-grp"><span>Slow orders</span><span>@Model.SlowOrders.Count</span></div>
                    @foreach (var o in Model.SlowOrders.Take(4))
                    {
                        var mins = (int)(Model.Now - o.OrderedAt).TotalMinutes;
                        <div class="dash-arow">
                            <span class="dash-mins"><b>@mins</b><span>MIN</span></span>
                            <span class="dash-what"><strong>@o.OrderNumber · @(o.RestaurantTable?.TableNumber is string tn ? "Table " + tn : o.CustomerName)</strong><span>@o.Status.DisplayName() for @mins min</span></span>
                            <a class="dash-btn" asp-page="/Admin/Orders/Index" asp-route-id="@o.Id">Open</a>
                        </div>
                    }
                }
                @if (Model.UnpaidTables.Any())
                {
                    <div class="dash-grp"><span>Unpaid tables</span><span>@Model.UnpaidTables.Count</span></div>
                    @foreach (var o in Model.UnpaidTables.Take(4))
                    {
                        <div class="dash-arow">
                            <span class="dash-rm">RM</span>
                            <span class="dash-what"><strong>Table @(o.RestaurantTable?.TableNumber ?? "—") · RM @o.TotalAmount.ToString("N2")</strong><span>Waiting to pay</span></span>
                            <a class="dash-btn" asp-page="/Admin/Orders/Index" asp-route-id="@o.Id">View</a>
                        </div>
                    }
                }
            }
            <div class="dash-alerts-foot"><span>Clears itself when each item is fixed.</span><span class="dash-ok">✓ @(Model.TablesTotal - Model.UnpaidTables.Count) tables fine</span></div>
        </div>

        @* ================= Booking schedule (agenda list) ================= *@
        <div class="dash-card dash-agenda">
            <div class="dash-card-head"><span class="dash-title">Booking schedule</span><span class="dash-label-sm">guests · table</span></div>
            @if (!Model.Agenda.Any())
            {
                <partial name="_Empty" model='new EmptyState("calendar", "No bookings today", null, null, null, true)' />
            }
            else
            {
                var nowShown = false;
                foreach (var row in Model.Agenda)
                {
                    var r = row.Booking;
                    if (!nowShown && r.StartTime >= Model.Now)
                    {
                        nowShown = true;
                        <div class="dash-now"><span>NOW @Model.Now.ToString("h:mm")</span></div>
                    }
                    var cls = row.State switch
                    {
                        DashboardModel.AgendaState.Arrived => "is-arrived",
                        DashboardModel.AgendaState.Past => "is-past",
                        DashboardModel.AgendaState.Next => "is-next",
                        _ => ""
                    };
                    <a class="dash-brow @cls" asp-page="/Reservations/Details" asp-route-id="@r.Id"
                       title="@r.CustomerName · @r.GuestCount guests · @r.StartTime.ToString("h:mm tt")–@r.EndTime.ToString("h:mm tt")@(string.IsNullOrWhiteSpace(r.SpecialRequests) ? "" : " · " + r.SpecialRequests)">
                        <span class="dash-btime">@r.StartTime.ToString("h:mm")</span>
                        <span class="dash-bwho"><strong>@r.CustomerName</strong> <span>· @r.GuestCount · @(r.RestaurantTable?.TableNumber ?? "—")</span></span>
                        @if (row.State == DashboardModel.AgendaState.Arrived) { <span class="dash-pill is-up">✓</span> }
                        else if (row.State == DashboardModel.AgendaState.Next) { <span class="dash-pill is-next">in @Math.Max(1, (int)Math.Ceiling((r.StartTime - Model.Now).TotalMinutes)) min</span> }
                    </a>
                }
                if (!nowShown)
                {
                    <div class="dash-now"><span>NOW @Model.Now.ToString("h:mm")</span></div>
                }
            }
        </div>
    </div>
</div>


@* ---------- Table popup ---------- *@
<div class="modal fade table-pop" id="table-modal" tabindex="-1" aria-labelledby="pop-status" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered table-pop-dialog">
        <div class="modal-content pop-card">
            @* Coloured band: matches the table's colour on the live map *@
            <div class="pop-band" id="pop-band">
                <div class="pop-num" id="pop-num"></div>
                <div class="pop-head">
                    <div class="pop-status" id="pop-status"></div>
                    <div class="pop-where" id="pop-where"></div>
                </div>
                <button type="button" class="pop-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                </button>
            </div>
            <div class="pop-body" id="pop-body"></div>
        </div>
    </div>
</div>
<script type="application/json" id="table-popup-data">@Html.Raw(Model.TablePopupJson)</script>
<script type="application/json" id="order-popup-data">@Html.Raw(Model.OrderPopupJson)</script>

@section Scripts {
    <script src="~/js/layout-chairs.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Chairs around each table on the live map.
            document.querySelectorAll('.live-map').forEach(function (box) {
                var fw = +box.dataset.floorW, fh = +box.dataset.floorH;
                box.querySelectorAll('.live-table').forEach(function (el) {
                    var t = { x: +el.dataset.x, y: +el.dataset.y, w: +el.dataset.w, h: +el.dataset.h,
                              shape: el.dataset.shape, capacity: el.dataset.capacity };
                    KomaChairs.positions(t).forEach(function (c) {
                        var ch = document.createElement('div');
                        ch.className = 'lay-preview-chair' + (c.kind === 'bench' ? ' is-bench' : '');
                        ch.style.left = (c.x / fw * 100) + '%';
                        ch.style.top = (c.y / fh * 100) + '%';
                        ch.style.width = (c.w / fw * 100) + '%';
                        ch.style.height = (c.h / fh * 100) + '%';
                        box.insertBefore(ch, el);
                    });
                });
            });

            // Table popup: fill the modal from the data sent with the page and show it.
            var popupData = JSON.parse(document.getElementById('table-popup-data').textContent || '{}');
            var modalEl = document.getElementById('table-modal');
            var modal = window.bootstrap ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
            function esc(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            var icons = {
                person: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>',
                receipt: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
                chevron: '<svg class="pop-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>'
            };
            var looks = { Occupied: 'is-seated', AwaitingPayment: 'is-payment', Free: 'is-free', Inactive: 'is-closed', Done: 'is-done', Cancelled: 'is-closed' };
            var orderPopupData = JSON.parse(document.getElementById('order-popup-data').textContent || '{}');
            var steps = [
                'Pending',
                'Queued',
                'Preparing',
                'Ready',
                'Served',
                'Completed'
            ];

            function showPopup(t) {
                    if (!t || !modal) return;
                    var o = t.order;

                    var band = document.getElementById('pop-band');
                    band.className = 'pop-band ' + (looks[t.state] || '');
                    document.getElementById('pop-num').textContent = t.number;
                    // Live orders show how long they've been seated; finished ones show when they were ordered.
                    document.getElementById('pop-status').textContent = t.stateLabel + (o ? ' · ' + (o.active ? o.seatedFor : o.orderedAt) : '');
                    document.getElementById('pop-where').textContent = t.number === '—'
                        ? t.zone + ' · no table'
                        : t.area + ' · ' + t.zone + ' · ' + t.capacity + ' seats';

                    var body;
                    if (!o) {
                        body =
                            '<p class="pop-free">' + (t.state === 'Inactive'
                                ? 'This table is closed. Turn it back on in the floor layout.'
                                : 'Free right now - ready for the next guests.') + '</p>' +
                            '<div class="pop-row muted">' + esc(t.floor) + ' · ' + esc(t.shape) + ' table</div>';
                    } else {
                        var progress = steps.map(function (label, i) {
                            var cls = i < o.step ? 'done' : i === o.step ? 'current' : '';
                            return '<div class="pop-step ' + cls + '"><div class="pop-step-bar"></div><span>' + label + '</span></div>';
                        }).join('');
                        var count = o.items.reduce(function (n, i) { return n + i.qty; }, 0);
                        var lines = o.items.map(function (i) {
                            return '<div class="pop-line"><span>' + i.qty + ' × ' + esc(i.name) + '</span><span>RM ' + esc(i.line) + '</span></div>';
                        }).join('');
                        body =
                            '<div class="pop-row strong">' + icons.person + esc(o.customer) + '</div>' +
                            '<div class="pop-row muted">' + icons.receipt + esc(o.type) + ' · ' + esc(o.number) + '</div>' +
                            (o.cancelled ? '<div class="pop-row muted">This order was cancelled.</div>'
                                         : '<div class="pop-label">Order progress</div><div class="pop-steps">' + progress + '</div>') +
                            '<div class="pop-items">' +
                                '<button type="button" class="pop-items-toggle" aria-expanded="true" aria-controls="pop-lines">' +
                                    '<span>' + count + ' item' + (count === 1 ? '' : 's') + '</span>' +
                                    '<span class="pop-items-total">RM ' + esc(o.total) + icons.chevron + '</span>' +
                                '</button>' +
                                '<div class="pop-lines" id="pop-lines">' + (lines || '<div class="pop-line muted">No items yet</div>') + '</div>' +
                            '</div>' +
                            (o.notes ? '<p class="pop-notes">Note: ' + esc(o.notes) + '</p>' : '') +
                            '<div class="pop-pay ' + (o.payment === 'Paid' ? 'is-paid' : '') + '">' + esc(o.payment) + '</div>';
                    }
                    var bodyEl = document.getElementById('pop-body');
                    bodyEl.innerHTML = body;

                    // Fold / unfold the item list.
                    var toggle = bodyEl.querySelector('.pop-items-toggle');
                    if (toggle) toggle.addEventListener('click', function () {
                        var open = toggle.getAttribute('aria-expanded') !== 'true';
                        toggle.setAttribute('aria-expanded', String(open));
                        toggle.parentElement.classList.toggle('is-collapsed', !open);
                    });
                    modal.show();
            }

            document.querySelectorAll('.live-table[data-table-id]').forEach(function (el) {
                el.addEventListener('click', function () { showPopup(popupData[el.dataset.tableId]); });
            });
            document.querySelectorAll('.latest-item[data-order-id]').forEach(function (el) {
                el.addEventListener('click', function () { showPopup(orderPopupData[el.dataset.orderId]); });
            });

            // Remember the chosen floor tab and the auto-refresh switch between refreshes.
            function load(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
            function save(key, v) { try { localStorage.setItem(key, v); } catch (e) { } }

            var savedFloor = load('koma.dashboard.floor');
            var tab = savedFloor && document.querySelector('[data-floor-id="' + savedFloor + '"]');
            if (tab && window.bootstrap) bootstrap.Tab.getOrCreateInstance(tab).show();
            document.querySelectorAll('[data-floor-id]').forEach(function (b) {
                b.addEventListener('shown.bs.tab', function () { save('koma.dashboard.floor', b.dataset.floorId); });
            });

            // Refresh the page every minute so seating, alerts and bookings stay current (always on).
            function scheduleRefresh() {
                setTimeout(function () {
                    // Don't reload while a popup is open - try again in a minute.
                    if (document.querySelector('.modal.show, dialog[open]')) { scheduleRefresh(); return; }
                    location.reload();
                }, 60000);
            }
            scheduleRefresh();

            // Total orders: tabs filter the number, average and comparison by order type.
            var dayName = '@Model.Now.ToString("ddd")';
            function showType(btn) {
                document.querySelectorAll('.dash-seg button').forEach(function (b) {
                    var on = b === btn; b.classList.toggle('is-on', on); b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                var n = +btn.dataset.count, last = +btn.dataset.last, cmp = document.getElementById('dash-ord-cmp');
                document.getElementById('dash-ord-num').textContent = n;
                document.getElementById('dash-ord-avg').textContent = 'RM ' + btn.dataset.avg;
                if (last === 0) { cmp.textContent = n ? 'First this weekday' : 'None yet'; cmp.className = 'dash-pill'; }
                else if (n === last) { cmp.textContent = 'Same as last ' + dayName; cmp.className = 'dash-pill'; }
                else { cmp.textContent = (n > last ? '↑ ' : '↓ ') + Math.abs(n - last) + ' vs last ' + dayName; cmp.className = 'dash-pill ' + (n > last ? 'is-up' : 'is-down'); }
            }
            document.querySelectorAll('.dash-seg button').forEach(function (b) {
                b.addEventListener('click', function (e) { e.stopPropagation(); showType(b); });
            });

            // Clicking anywhere else on the Total orders card opens the Orders page for today
            // (with the selected type, if one is chosen).
            var ordersCard = document.getElementById('dash-orders');
            function openOrders() {
                var url = ordersCard.dataset.href, on = document.querySelector('.dash-seg button.is-on');
                if (on && on.dataset.type) url += (url.indexOf('?') < 0 ? '?' : '&') + 'type=' + encodeURIComponent(on.dataset.type);
                location.href = url;
            }
            if (ordersCard) {
                ordersCard.addEventListener('click', openOrders);
                ordersCard.addEventListener('keydown', function (e) {
                    if ((e.key === 'Enter' || e.key === ' ') && e.target === ordersCard) { e.preventDefault(); openOrders(); }
                });
            }
            var firstTab = document.querySelector('.dash-seg button');
            if (firstTab) showType(firstTab);
        })();
    </script>
}
