@page
@model KOMA.Pages.Admin.LandingPage.IndexModel
@{
    ViewData["Title"] = "Website";
    var c = Model.Content;
    var heroImage = string.IsNullOrWhiteSpace(c.HeroImageUrl) ? Url.Content("~/images/koma/japanese-table.jpg") : c.HeroImageUrl;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="mn-toast" id="mn-toast" role="status" aria-live="polite">
        <span class="mn-toast-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
        <span class="mn-toast-text"><strong>Changes saved</strong><span>@status</span></span>
        <button type="button" class="mn-toast-close" aria-label="Close">&times;</button>
    </div>
}

<div class="lp-head">
    <div>
        <h1 class="mb-1">Website</h1>
        <p class="mn-muted mb-0">
            Edit what customers see on the KOMA landing page.
            @(Model.IsSaved && c.UpdatedAt.HasValue ? $"Last updated {c.UpdatedAt.Value:d MMM yyyy, h:mm tt}." : "Showing the original wording - nothing changed yet.")
        </p>
    </div>
    <a class="btn btn-outline-primary ms-auto" asp-page="/Index" target="_blank" rel="noopener">View landing page ↗</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert"><strong>Not saved.</strong> Please fix the following:<div asp-validation-summary="All" class="mt-1"></div></div>
}

<div class="lp-shell">
    <nav class="lp-nav" aria-label="Sections">
        <div class="mn-eyebrow">Sections</div>
        <a href="#lp-hero">Top banner</a>
        <a href="#lp-food">Dishes</a>
        <a href="#lp-story">Our story</a>
        <a href="#lp-experience">Experience cards</a>
        <a href="#lp-invite">Closing</a>
    </nav>

    <form method="post" enctype="multipart/form-data" id="lp-form" class="lp-form js-confirm-save" data-kind="page" data-new="0" data-name="the landing page">

        @* ---------- Top banner ---------- *@
        <section class="card lp-card" id="lp-hero">
            <h2>Top banner</h2>
            <div class="lp-hero-preview" aria-label="Preview of the top banner">
                <img src="@heroImage" alt="" id="lp-hero-img" />
                <div class="lp-hero-copy">
                    <small data-preview="Content_HeroEyebrow">@c.HeroEyebrow</small>
                    <strong><span data-preview="Content_HeroTitle">@c.HeroTitle</span><br /><em data-preview="Content_HeroTitleAccent">@c.HeroTitleAccent</em></strong>
                    <span class="lp-hero-intro" data-preview="Content_HeroIntro">@c.HeroIntro</span>
                    <span class="lp-hero-btn"><span data-preview="Content_HeroButtonText">@c.HeroButtonText</span> ↓</span>
                </div>
                <label class="mn-photo-btn" for="lp-photo">Change photo</label>
            </div>
            <input asp-for="HeroPhoto" id="lp-photo" type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" data-label="Banner photo" />
            <span asp-validation-for="HeroPhoto" class="text-danger small"></span>
            @if (!string.IsNullOrWhiteSpace(c.HeroImageUrl))
            {
                <div class="form-check mt-2">
                    <input asp-for="RemovePhoto" class="form-check-input" data-label="Use original photo" />
                    <label asp-for="RemovePhoto" class="form-check-label">Go back to the original photo</label>
                </div>
            }
            <div class="lp-grid">
                <div><label asp-for="Content.HeroEyebrow" class="form-label"></label><input asp-for="Content.HeroEyebrow" class="form-control" data-label="Banner small heading" /></div>
                <div><label asp-for="Content.HeroButtonText" class="form-label"></label><input asp-for="Content.HeroButtonText" class="form-control" data-label="Banner button" /><span asp-validation-for="Content.HeroButtonText" class="text-danger small"></span></div>
                <div><label asp-for="Content.HeroTitle" class="form-label"></label><input asp-for="Content.HeroTitle" class="form-control" data-label="Banner heading" /><span asp-validation-for="Content.HeroTitle" class="text-danger small"></span></div>
                <div><label asp-for="Content.HeroTitleAccent" class="form-label"></label><input asp-for="Content.HeroTitleAccent" class="form-control" data-label="Banner heading line 2" /></div>
                <div class="lp-wide"><label asp-for="Content.HeroIntro" class="form-label"></label><textarea asp-for="Content.HeroIntro" rows="2" class="form-control" data-label="Banner introduction"></textarea></div>
            </div>
        </section>

        @* ---------- Dishes ---------- *@
        <section class="card lp-card" id="lp-food">
            <h2>Dishes</h2>
            <div class="lp-grid">
                <div><label asp-for="Content.FoodEyebrow" class="form-label"></label><input asp-for="Content.FoodEyebrow" class="form-control" data-label="Dishes small heading" /></div>
                <div><label asp-for="Content.FoodTitle" class="form-label"></label><input asp-for="Content.FoodTitle" class="form-control" data-label="Dishes heading" /><span asp-validation-for="Content.FoodTitle" class="text-danger small"></span></div>
                <div class="lp-wide"><label asp-for="Content.FoodIntro" class="form-label"></label><textarea asp-for="Content.FoodIntro" rows="2" class="form-control" data-label="Dishes introduction"></textarea></div>
            </div>
            <div class="lp-rows">
                <div class="lp-row">
                    <div class="form-check form-switch"><input asp-for="Content.ShowRecommended" class="form-check-input" role="switch" data-label="Show Recommended row" /><label asp-for="Content.ShowRecommended" class="form-check-label"></label></div>
                    <input asp-for="Content.RecommendedTitle" class="form-control" aria-label="Recommended row title" data-label="Recommended row title" />
                    <span class="mn-muted">@Model.RecommendedCount dish@(Model.RecommendedCount == 1 ? "" : "es")</span>
                </div>
                <div class="lp-row">
                    <div class="form-check form-switch"><input asp-for="Content.ShowSeasonal" class="form-check-input" role="switch" data-label="Show Seasonal row" /><label asp-for="Content.ShowSeasonal" class="form-check-label"></label></div>
                    <input asp-for="Content.SeasonalTitle" class="form-control" aria-label="Seasonal row title" data-label="Seasonal row title" />
                    <span class="mn-muted">@Model.SeasonalCount dish@(Model.SeasonalCount == 1 ? "" : "es")</span>
                </div>
            </div>
            <p class="mn-muted small mb-0">Which dishes appear is set on the <a asp-page="/Admin/MenuItems/Index">Menu page</a> with each dish's ★ Recommended and Seasonal switches.</p>
        </section>

        @* ---------- Story ---------- *@
        <section class="card lp-card" id="lp-story">
            <div class="lp-card-head">
                <h2>Our story</h2>
                <div class="form-check form-switch ms-auto"><input asp-for="Content.ShowStory" class="form-check-input" role="switch" data-label="Show Our story" /><label asp-for="Content.ShowStory" class="form-check-label"></label></div>
            </div>
            <div class="lp-grid">
                <div><label asp-for="Content.StoryEyebrow" class="form-label"></label><input asp-for="Content.StoryEyebrow" class="form-control" data-label="Story small heading" /></div>
                <div><label asp-for="Content.StoryTitle" class="form-label"></label><input asp-for="Content.StoryTitle" class="form-control" data-label="Story heading" /><span asp-validation-for="Content.StoryTitle" class="text-danger small"></span></div>
                <div class="lp-wide"><label asp-for="Content.StoryText" class="form-label"></label><textarea asp-for="Content.StoryText" rows="3" class="form-control" data-label="Story text"></textarea></div>
            </div>
        </section>

        @* ---------- Experience cards ---------- *@
        <section class="card lp-card" id="lp-experience">
            <div class="lp-card-head">
                <h2>Experience cards</h2>
                <div class="form-check form-switch ms-auto"><input asp-for="Content.ShowExperience" class="form-check-input" role="switch" data-label="Show Experience cards" /><label asp-for="Content.ShowExperience" class="form-check-label"></label></div>
            </div>
            <div class="lp-grid">
                <div><label asp-for="Content.ExperienceEyebrow" class="form-label"></label><input asp-for="Content.ExperienceEyebrow" class="form-control" data-label="Experience small heading" /></div>
                <div><label asp-for="Content.ExperienceTitle" class="form-label"></label><input asp-for="Content.ExperienceTitle" class="form-control" data-label="Experience heading" /><span asp-validation-for="Content.ExperienceTitle" class="text-danger small"></span></div>
            </div>
            <div class="lp-cards">
                <div class="lp-mini">
                    <input asp-for="Content.Card1Eyebrow" class="form-control form-control-sm" aria-label="Card 1 label" data-label="Card 1 label" />
                    <input asp-for="Content.Card1Title" class="form-control" aria-label="Card 1 heading" data-label="Card 1 heading" />
                    <textarea asp-for="Content.Card1Text" rows="3" class="form-control form-control-sm" aria-label="Card 1 text" data-label="Card 1 text"></textarea>
                </div>
                <div class="lp-mini">
                    <input asp-for="Content.Card2Eyebrow" class="form-control form-control-sm" aria-label="Card 2 label" data-label="Card 2 label" />
                    <input asp-for="Content.Card2Title" class="form-control" aria-label="Card 2 heading" data-label="Card 2 heading" />
                    <textarea asp-for="Content.Card2Text" rows="3" class="form-control form-control-sm" aria-label="Card 2 text" data-label="Card 2 text"></textarea>
                </div>
                <div class="lp-mini">
                    <input asp-for="Content.Card3Eyebrow" class="form-control form-control-sm" aria-label="Card 3 label" data-label="Card 3 label" />
                    <input asp-for="Content.Card3Title" class="form-control" aria-label="Card 3 heading" data-label="Card 3 heading" />
                    <textarea asp-for="Content.Card3Text" rows="3" class="form-control form-control-sm" aria-label="Card 3 text" data-label="Card 3 text"></textarea>
                </div>
            </div>
            <p class="mn-muted small mb-0">Leave a card's heading empty to hide that card.</p>
        </section>

        @* ---------- Closing ---------- *@
        <section class="card lp-card" id="lp-invite">
            <h2>Closing</h2>
            <label asp-for="Content.InvitationHeading" class="form-label"></label>
            <input asp-for="Content.InvitationHeading" class="form-control" data-label="Closing heading" />
            <span asp-validation-for="Content.InvitationHeading" class="text-danger small"></span>
        </section>
    </form>
</div>

<div class="lp-savebar">
    <span class="mn-muted small">Tip: press Enter in a text box to start a new line on the page.</span>
    <form method="post" asp-page-handler="Reset" class="ms-auto"
          data-confirm-title="Reset the landing page?" data-confirm-text="All wording and the banner photo go back to the original KOMA versions. Your dish choices on the Menu page are not changed." data-confirm-ok="Reset">
        <button type="submit" class="btn mn-btn-danger">Reset to original</button>
    </form>
    <button type="submit" form="lp-form" class="btn btn-primary">Save changes</button>
</div>

<dialog class="mn-dialog" id="mn-confirm" aria-labelledby="mn-confirm-title">
    <div class="mn-dialog-body">
        <div class="mn-eyebrow" id="mn-confirm-eyebrow">Confirm changes</div>
        <h2 id="mn-confirm-title">Save changes?</h2>
        <p id="mn-confirm-text" class="mn-muted mb-0"></p>
        <ul id="mn-confirm-list" class="mn-changes"></ul>
    </div>
    <div class="mn-dialog-actions">
        <button type="button" class="btn btn-outline-primary" id="mn-confirm-cancel">Cancel</button>
        <button type="button" class="btn btn-primary" id="mn-confirm-ok">Confirm</button>
    </div>
</dialog>

@section Scripts {
    <script>
        // Live preview of the top banner while typing.
        document.querySelectorAll('[data-preview]').forEach(el => {
            const input = document.getElementById(el.dataset.preview);
            input?.addEventListener('input', () => { el.textContent = input.value; });
        });
        document.getElementById('lp-photo')?.addEventListener('change', e => {
            const f = e.target.files && e.target.files[0];
            if (f) document.getElementById('lp-hero-img').src = URL.createObjectURL(f);
        });

        // Confirmation popup (same as the Menu page) and the green "saved" popup.
        (() => {
            const dlg = document.getElementById('mn-confirm'), $ = id => document.getElementById(id);
            const esc = t => String(t).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
            const short = t => t.length > 60 ? t.slice(0, 57) + '…' : t;
            let pending = null;
            const valueOf = el => el.type === 'checkbox' ? (el.checked ? 'On' : 'Off')
                : el.type === 'file' ? (el.files && el.files[0] ? el.files[0].name : '') : el.value.trim();
            const open = o => {
                $('mn-confirm-eyebrow').textContent = o.eyebrow; $('mn-confirm-title').textContent = o.title;
                $('mn-confirm-text').textContent = o.text || '';
                $('mn-confirm-list').innerHTML = (o.rows || []).join(''); $('mn-confirm-list').hidden = !(o.rows || []).length;
                const ok = $('mn-confirm-ok'); ok.hidden = !o.onOk; ok.textContent = o.ok || 'Confirm';
                ok.className = 'btn ' + (o.danger ? 'mn-btn-danger-solid' : 'btn-primary');
                $('mn-confirm-cancel').textContent = o.onOk ? 'Cancel' : 'OK';
                pending = o.onOk; dlg.showModal(); (o.onOk ? ok : $('mn-confirm-cancel')).focus();
            };
            $('mn-confirm-cancel').addEventListener('click', () => dlg.close());
            $('mn-confirm-ok').addEventListener('click', () => { const go = pending; pending = null; dlg.close(); go && go(); });
            dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });

            document.querySelectorAll('form.js-confirm-save').forEach(form => {
                const fields = () => [...form.querySelectorAll('[data-label]')];
                const before = new Map(fields().map(el => [el, valueOf(el)]));
                form.addEventListener('submit', e => {
                    e.preventDefault();
                    const rows = fields().filter(el => before.get(el) !== valueOf(el)).map(el =>
                        `<li><span>${esc(el.dataset.label)}</span><s>${esc(short(before.get(el) || '(empty)'))}</s><b aria-hidden="true">→</b><strong>${esc(short(valueOf(el) || '(empty)'))}</strong></li>`);
                    if (!rows.length) { open({ eyebrow: 'Nothing to save', title: 'No changes yet', text: "You haven't changed anything on the landing page." }); return; }
                    open({ eyebrow: 'Confirm changes', title: `Publish ${rows.length} change${rows.length === 1 ? '' : 's'} to the landing page?`,
                           text: 'Customers will see these straight away.', rows, ok: 'Save changes',
                           onOk: () => HTMLFormElement.prototype.submit.call(form) });
                });
            });
            document.querySelectorAll('form[data-confirm-title]').forEach(form => form.addEventListener('submit', e => {
                e.preventDefault();
                open({ eyebrow: 'Please confirm', title: form.dataset.confirmTitle, text: form.dataset.confirmText,
                       ok: form.dataset.confirmOk, danger: true, onOk: () => HTMLFormElement.prototype.submit.call(form) });
            }));

            const toast = $('mn-toast');
            if (toast) {
                const hide = () => { toast.classList.add('is-leaving'); setTimeout(() => toast.remove(), 300); };
                toast.querySelector('.mn-toast-close').addEventListener('click', hide);
                setTimeout(hide, 3200);
            }
        })();
    </script>
}
