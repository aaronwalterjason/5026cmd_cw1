@page "{id:int}"
@model KOMA.Pages.Admin.Layouts.EditModel
@{
    ViewData["Title"] = "Edit Floor Layout";
}

<h1>Edit Floor</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <partial name="_FloorForm" for="Floor" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="./Designer" asp-route-id="@Model.Floor.Id" class="btn btn-outline-secondary">Open layout</a>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <script src="~/js/floor-size-drawer.js" asp-append-version="true"></script>
}
