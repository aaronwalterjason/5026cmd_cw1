@page
@model IndexModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Good food. Good company.";
}
<section class="hero hero-wide" aria-labelledby="hero-title">
    <img class="hero-background" src="~/images/koma/japanese-table.jpg" alt="" fetchpriority="high" />
    <div class="hero-copy">
        <p class="eyebrow">A LITTLE TASTE OF JAPAN</p>
        <h1 id="hero-title">Good food.<br /><em>Better together.</em></h1>
        <p class="intro">Bring your appetite. Bring your favourite people.<br />There is always a little more to enjoy at KOMA.</p>
        <a class="button light" href="#food">Find your favourite <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-bottom"><span>JAPANESE-INSPIRED DINING</span><span>SCROLL TO SAVOUR ↓</span></div>
</section>
<section class="food-section wave-pattern" id="food" aria-labelledby="food-title">
    <div class="food-heading reveal"><p class="eyebrow">SOMETHING GOOD IS ON THE TABLE</p><h2 id="food-title">What are you craving?</h2><p>A familiar favourite or something a little different.<br />Take a look around. Find your next good bite.</p></div>
    @foreach (var category in new[] { "Recommended", "Seasonal Specials" })
    {
        var dishes = Model.Dishes.Where(dish => category == "Recommended" ? dish.IsRecommended : dish.IsSeasonal).ToList();
        var galleryId = category == "Recommended" ? "recommended" : "seasonal";
        <section class="food-gallery" aria-labelledby="@(galleryId)-title" aria-roledescription="carousel">
            <div class="food-toolbar">
                <h3 id="@(galleryId)-title">@category</h3>
            </div>
            @if (dishes.Count == 0)
            {
                <p class="food-empty">New dishes are on the way. Check back soon.</p>
            }
            <div class="food-track" aria-label="@category dishes" tabindex="0">
        @foreach (var dish in dishes)
        {
            <article class="food-card" data-category="@((dish.IsRecommended ? "recommended " : "") + (dish.IsSeasonal ? "seasonal" : ""))">
                <div class="dish-photo">
                    @if (!string.IsNullOrWhiteSpace(dish.ImageUrl))
                    {
                        <img src="@dish.ImageUrl" alt="@dish.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="photo-placeholder">Photo coming soon</span>
                    }
                </div>
                <div class="food-card-body"><p class="eyebrow">@(dish.IsRecommended && dish.IsSeasonal ? "KOMA PICKS / SEASONAL" : dish.IsRecommended ? "KOMA PICKS" : "SEASONAL SPOTLIGHT")</p><h3>@dish.Name</h3><p>@dish.Description</p>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="button order-button" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Index", new { dish = dish.Id })" aria-label="Order @dish.Name now">Order Now <span aria-hidden="true">↗</span></a>
                    }
                    else
                    {
                        <button class="button order-button" type="button" data-order-message="@(User.IsInRole("Customer") ? "Online ordering is not available yet. Please check back soon." : "Ordering is available to customer accounts. Please sign in with a customer account.")" aria-label="Order @dish.Name now">Order Now <span aria-hidden="true">↗</span></button>
                    }
                </div>
            </article>
        }
    </div>
        </section>
    }
    <p class="order-status" role="status" aria-live="polite">@if (Request.Query.ContainsKey("dish") && User.Identity?.IsAuthenticated == true) { <text>@(User.IsInRole("Customer") ? "You are signed in. Online ordering is not available yet. Please check back soon." : "Ordering is available to customer accounts. Please sign in with a customer account.")</text> }</p>
</section>
<section class="story reveal" id="story">
    <p class="eyebrow">THE KOMA WAY</p>
    <h2>Good food brings us together.</h2>
    <p>We believe the best meals are as much about the people as the food. Bring your favourite company, settle in, and enjoy a meal at your own pace.</p>
</section>
<section class="experience" id="experience">
    <div class="reveal">
        <p class="eyebrow">MAKE YOURSELF AT HOME</p>
        <h2>More than a meal.</h2>
    </div>
    <div class="cards">
        <article class="reveal">
            <span class="eyebrow">01 / THE FOOD</span>
            <h3>Find your next favourite.</h3>
            <p>Explore Japanese-inspired flavours, from delicate bites to crisp, satisfying crunches.</p>
        </article>
        <article class="reveal">
            <span class="eyebrow">02 / THE COMPANY</span>
            <h3>There’s room for everyone.</h3>
            <p>Bring friends, gather family, or enjoy a quiet meal on your own.</p>
        </article>
        <article class="reveal">
            <span class="eyebrow">03 / THE MOMENT</span>
            <h3>Stay a little longer.</h3>
            <p>Catch up over a meal, celebrate an occasion, or simply enjoy being here.</p>
        </article>
    </div>
</section>
<section class="invitation reveal">
    <h2>@KOMA.Models.KomaBrand.InvitationHeading</h2>
    @if (User.Identity?.IsAuthenticated == true) { <a class="button light" asp-area="Identity" asp-page="/Account/Manage/Index">Your account <span aria-hidden="true">↗</span></a> }
    else { <a class="button light" asp-area="Identity" asp-page="/Account/Register">Join KOMA <span aria-hidden="true">↗</span></a> }
</section>
