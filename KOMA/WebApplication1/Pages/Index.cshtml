@page
@model IndexModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Good food. Good company.";
    var c = Model.Content;   // wording + photo edited in Admin > Website
    var heroImage = string.IsNullOrWhiteSpace(c.HeroImageUrl) ? Url.Content("~/images/koma/japanese-table.jpg") : c.HeroImageUrl;
}
@functions {
    // Text typed in the admin form: keep it safe (HTML-encoded) and turn each new line into <br />.
    private Microsoft.AspNetCore.Html.IHtmlContent Lines(string? text) =>
        new Microsoft.AspNetCore.Html.HtmlString(string.Join("<br />",
            (text ?? "").Replace("\r", "").Split('\n').Select(l => System.Net.WebUtility.HtmlEncode(l))));
}
<section class="hero hero-wide" aria-labelledby="hero-title">
    <img class="hero-background" src="@heroImage" alt="" fetchpriority="high" />
    <div class="hero-copy">
        @if (!string.IsNullOrWhiteSpace(c.HeroEyebrow)) { <p class="eyebrow">@c.HeroEyebrow</p> }
        <h1 id="hero-title">@(c.HeroTitle)@if (!string.IsNullOrWhiteSpace(c.HeroTitleAccent)) { <br /><em>@c.HeroTitleAccent</em> }</h1>
        @if (!string.IsNullOrWhiteSpace(c.HeroIntro)) { <p class="intro">@Lines(c.HeroIntro)</p> }
        <a class="button light" href="#food">@c.HeroButtonText <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-bottom"><span>JAPANESE-INSPIRED DINING</span><span>SCROLL TO SAVOUR ↓</span></div>
</section>
<section class="food-section wave-pattern" id="food" aria-labelledby="food-title">
    <div class="food-heading reveal">@if (!string.IsNullOrWhiteSpace(c.FoodEyebrow)) { <p class="eyebrow">@c.FoodEyebrow</p> }<h2 id="food-title">@c.FoodTitle</h2>@if (!string.IsNullOrWhiteSpace(c.FoodIntro)) { <p>@Lines(c.FoodIntro)</p> }</div>
    @foreach (var (isRecommended, category) in new[] { (true, c.RecommendedTitle), (false, c.SeasonalTitle) })
    {
        if (isRecommended ? !c.ShowRecommended : !c.ShowSeasonal) { continue; }
        var dishes = isRecommended ? Model.RecommendedDishes : Model.Dishes.Where(dish => dish.IsSeasonal).ToList();
        var galleryId = isRecommended ? "recommended" : "seasonal";
        <section class="food-gallery" aria-labelledby="@(galleryId)-title" aria-roledescription="carousel">
            <div class="food-toolbar">
                <h3 id="@(galleryId)-title">@category</h3>
            </div>
            @if (dishes.Count == 0)
            {
                <p class="food-empty">New dishes are on the way. Check back soon.</p>
            }
            <div class="food-track" aria-label="@category dishes" tabindex="0">
        @foreach (var dish in dishes)
        {
            <article class="food-card" data-category="@((dish.IsRecommended ? "recommended " : "") + (dish.IsSeasonal ? "seasonal" : ""))">
                <div class="dish-photo">
                    @if (!string.IsNullOrWhiteSpace(dish.ImageUrl))
                    {
                        <img src="@dish.ImageUrl" alt="@dish.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="photo-placeholder">Photo coming soon</span>
                    }
                </div>
                <div class="food-card-body"><p class="eyebrow">@((isRecommended || dish.IsRecommended) && dish.IsSeasonal ? "KOMA PICKS / SEASONAL" : isRecommended || dish.IsRecommended ? "KOMA PICKS" : "SEASONAL SPOTLIGHT")</p><h3>@dish.Name</h3><p>@dish.Description</p>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="button order-button" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Reservations/Edit", new { area = "" })" aria-label="Order @dish.Name now">Order Now <span aria-hidden="true">↗</span></a>
                    }
                    else if (User.IsInRole("Customer"))
                    {
                        <a class="button order-button" asp-area="" asp-page="/Reservations/Edit" aria-label="Order @dish.Name now">Order Now <span aria-hidden="true">↗</span></a>
                    }
                    else
                    {
                        <button class="button order-button" type="button" data-order-message="Ordering is available to customer accounts. Please sign in with a customer account." aria-label="Order @dish.Name now">Order Now <span aria-hidden="true">↗</span></button>
                    }
                </div>
            </article>
        }
    </div>
        </section>
    }
    <section class="food-gallery promotion-gallery" id="promotions" aria-labelledby="promotions-title" aria-roledescription="carousel">
        <div class="food-toolbar"><h3 id="promotions-title">Promotions</h3></div>
        @if (Model.Promotions.Count == 0)
        {
            <p class="food-empty">New promotions are on the way. Check back soon.</p>
        }
        <div class="food-track" aria-label="Promotion pictures" tabindex="0">
            @foreach (var promotion in Model.Promotions)
            {
                <button class="food-card promotion-card" type="button" data-promotion-dialog="promotion-@promotion.Id"
                        aria-label="View @promotion.Title promotion details" aria-haspopup="dialog" aria-controls="promotion-@promotion.Id">
                    <span class="dish-photo"><img src="@promotion.BannerImageUrl" alt="@promotion.Title" loading="lazy" /></span>
                </button>
            }
        </div>
    </section>
    <p class="order-status" role="status" aria-live="polite"></p>
</section>
@foreach (var promotion in Model.Promotions)
{
    <dialog class="promotion-dialog" id="promotion-@promotion.Id" aria-labelledby="promotion-title-@promotion.Id">
        <div class="promotion-dialog-header">
            <p class="eyebrow">KOMA PROMOTIONS</p>
            <button type="button" class="promotion-close" data-close-promotion aria-label="Close promotion details" autofocus>×</button>
        </div>
        <img class="promotion-detail-image" src="@promotion.BannerImageUrl" alt="@promotion.Title" loading="lazy" />
        <div class="promotion-details">
            <h2 id="promotion-title-@promotion.Id">@promotion.Title</h2>
            @if (!string.IsNullOrWhiteSpace(promotion.BannerText))
            {
                <p>@Lines(promotion.BannerText)</p>
            }
            <dl class="promotion-facts">
                <div><dt>Offer</dt><dd>@promotion.DiscountPercent.ToString("0.##")% off selected dishes</dd></div>
                <div><dt>Dates</dt><dd>@promotion.StartDate.ToString("d MMM yyyy") – @promotion.EndDate.ToString("d MMM yyyy")</dd></div>
                <div><dt>When</dt><dd>@promotion.ScheduleText() <span>(Malaysia time)</span></dd></div>
            </dl>
            @if (promotion.MenuItems.Count > 0)
            {
                <h3>Included dishes</h3>
                <ul class="promotion-dishes">
                    @foreach (var dish in promotion.MenuItems.OrderBy(m => m.Name))
                    {
                        <li>@dish.Name</li>
                    }
                </ul>
            }
        </div>
    </dialog>
}
@if (c.ShowStory)
{
<section class="story reveal" id="story">
    @if (!string.IsNullOrWhiteSpace(c.StoryEyebrow)) { <p class="eyebrow">@c.StoryEyebrow</p> }
    <h2>@c.StoryTitle</h2>
    @if (!string.IsNullOrWhiteSpace(c.StoryText)) { <p>@Lines(c.StoryText)</p> }
</section>
}
@if (c.ShowExperience)
{
<section class="experience" id="experience">
    <div class="reveal">
        @if (!string.IsNullOrWhiteSpace(c.ExperienceEyebrow)) { <p class="eyebrow">@c.ExperienceEyebrow</p> }
        <h2>@c.ExperienceTitle</h2>
    </div>
    <div class="cards">
        @foreach (var (label, title, text) in new[] { (c.Card1Eyebrow, c.Card1Title, c.Card1Text), (c.Card2Eyebrow, c.Card2Title, c.Card2Text), (c.Card3Eyebrow, c.Card3Title, c.Card3Text) })
        {
            if (string.IsNullOrWhiteSpace(title)) { continue; }
            <article class="reveal">
                @if (!string.IsNullOrWhiteSpace(label)) { <span class="eyebrow">@label</span> }
                <h3>@title</h3>
                @if (!string.IsNullOrWhiteSpace(text)) { <p>@Lines(text)</p> }
            </article>
        }
    </div>
</section>
}
<section class="invitation reveal">
    <h2>@c.InvitationHeading</h2>
    @if (User.Identity?.IsAuthenticated == true) { <a class="button light" asp-area="Identity" asp-page="/Account/Manage/Index">Your account <span aria-hidden="true">↗</span></a> }
    else { <a class="button light" asp-area="Identity" asp-page="/Account/Register">Join KOMA <span aria-hidden="true">↗</span></a> }
</section>
