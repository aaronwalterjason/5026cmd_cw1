@page "{id:int}"
@model KOMA.Pages.Reservations.DetailsModel
@using KOMA.Models
@{ ViewData["Title"] = "Reservation details"; var booking = Model.Booking; }
<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <h1 class="mb-0">Reservation R-@booking.Id.ToString("D5")</h1>
    <a asp-page="@Model.BackPage" asp-route-date="@booking.StartTime.ToString("yyyy-MM-dd")" asp-route-time="@booking.StartTime.ToString("HH:mm")" class="btn btn-outline-secondary flex-shrink-0" aria-label="@(Model.IsStaff ? "Back to layout" : "Back to my reservations")" title="@(Model.IsStaff ? "Back to layout" : "Back to my reservations")">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H4v16h5m6-13 5 5-5 5M8 12h12"/></svg>
    </a>
</div>
@if (User.IsInRole("Customer"))
{
    <div class="mb-3"><partial name="_DiningQrLink" /></div>
}
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="card mb-4"><div class="card-header"><strong>@(booking.Status == ReservationStatus.NoShow ? "No-show" : booking.Status.ToString())</strong></div><div class="card-body">
    @if (booking.ExpectedArrival.HasValue && booking.Status == ReservationStatus.Confirmed) { <p>Agreed arrival: @booking.ExpectedArrival.Value.ToString("dd MMM yyyy, HH:mm") (Malaysia time)</p> }
    <dl class="row mb-0">
        <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@booking.CustomerName</dd>
        <dt class="col-sm-3">Contact number</dt><dd class="col-sm-9">@booking.ContactNumber</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(booking.Email ?? "Not provided")</dd>
        <dt class="col-sm-3">Table</dt><dd class="col-sm-9">@booking.RestaurantTable.TableNumber · @booking.RestaurantTable.DiningArea?.Name</dd>
        <dt class="col-sm-3">Date and time</dt><dd class="col-sm-9">@booking.StartTime.ToString("dd MMM yyyy, HH:mm") – @booking.EndTime.ToString("HH:mm") (Malaysia)</dd>
        <dt class="col-sm-3">Guests</dt><dd class="col-sm-9">@booking.GuestCount / capacity @booking.RestaurantTable.Capacity</dd>
        <dt class="col-sm-3">Requests / preferences</dt><dd class="col-sm-9" style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(booking.SpecialRequests) ? "None" : booking.SpecialRequests)</dd>
    </dl>
</div></div>
<section class="card mb-4" aria-labelledby="preordered-food-heading">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 id="preordered-food-heading" class="h5 mb-0">Pre-ordered food</h2>
        @if (Model.PreOrder != null || Model.CanEditPreOrder)
        {
            <a asp-page="PreOrder" asp-route-id="@booking.Id" class="btn btn-outline-primary btn-sm">@(Model.CanEditPreOrder ? (Model.PreOrder == null ? "Add pre-order" : "Edit / remove pre-order") : "View pre-order")</a>
        }
    </div>
    <div class="card-body">
        @if (Model.PreOrder != null)
        {
            <ul class="list-unstyled mb-3">
                @foreach (var item in Model.PreOrder.Items.OrderBy(i => i.Id))
                {
                    <li class="d-flex align-items-center gap-3 py-2">
                        @if (!string.IsNullOrWhiteSpace(item.MenuItem?.ImageUrl))
                        {
                            <img src="@item.MenuItem.ImageUrl" alt="@item.DishName" class="reservation-food-image" loading="lazy" />
                        }
                        else
                        {
                            <span class="reservation-food-image reservation-food-placeholder">No image</span>
                        }
                        <span class="flex-grow-1">@item.Quantity × @item.DishName</span>
                        <strong class="text-nowrap">RM @item.LineTotal.ToString("N2")</strong>
                    </li>
                }
            </ul>
            <div class="d-flex justify-content-between gap-3 border-top pt-2">
                <span>Food total</span><strong class="text-nowrap">RM @Model.PreOrder.TotalAmount.ToString("N2")</strong>
            </div>
        }
        else
        {
            <p class="mb-0">No pre-order</p>
        }
    </div>
</section>
@if (Model.CanGiveFeedback)
{
    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
    <section class="feedback-box" aria-label="Reservation feedback">
        <iframe src="@Url.Page("/Feedback", new { reservationId = booking.Id })" title="Reservation feedback" loading="lazy"></iframe>
    </section>
}
<div class="d-flex flex-wrap gap-2 mb-3">
    @if (Model.CanChange)
    {
        <a asp-page="Edit" asp-route-id="@booking.Id" class="btn btn-primary">Edit reservation</a>
        @if (Model.IsStaff && booking.Status == ReservationStatus.Pending)
        {
            <form method="post" asp-page-handler="Confirm" asp-route-id="@booking.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(booking.RowVersion)" /><button class="btn btn-success" type="submit">Confirm reservation</button></form>
        }
    }
</div>
@if (Model.CanChange)
{
    <form method="post" asp-page-handler="Cancel" asp-route-id="@booking.Id" class="border rounded p-3">
        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(booking.RowVersion)" />
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirmCancel" value="true" id="confirmCancel" required /><label class="form-check-label" for="confirmCancel">I confirm this reservation should be cancelled and its table released.</label></div>
        <button type="submit" class="btn btn-outline-danger">Cancel reservation</button>
    </form>
}

