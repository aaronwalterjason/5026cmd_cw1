@page "{id:int}"
@model KOMA.Pages.Reservations.PreOrderModel
@using KOMA.Models
@using System.Globalization
@{ ViewData["Title"] = "Your KOMA menu"; }
<link rel="stylesheet" href="~/css/preorder.css" asp-append-version="true" />
<section class="po">
    <header class="po-header">
        <div><a class="po-back" asp-page="Details" asp-route-id="@Model.Id">← Reservation R-@Model.Id.ToString("D5")</a>
        <p class="po-eyebrow">YOUR TABLE. YOUR FAVOURITES.</p><h1>A little taste of <em>what’s to come.</em></h1>
        <p>Pick something delicious now. We’ll keep your pre-order ready for your arrival.</p></div>
        @if (Model.Booking != null) { <div class="po-visit"><span>YOUR VISIT</span><strong>@Model.Booking.StartTime.ToString("dd MMM · HH:mm")</strong><span>@Model.Booking.GuestCount guests · Malaysia time</span></div> }
    </header>
    @if (Model.ExistingOrder != null)
    {
        <details class="po-saved" open="@(!Model.CanEdit)">
            <summary>Saved pre-order · @Model.ExistingOrder.Status.DisplayName() · RM @Model.ExistingOrder.TotalAmount.ToString("N2")</summary>
            <partial name="_OrderBill" model="Model.ExistingOrder" />
            @if (Model.CanEdit) { <p>Your saved order stays unchanged until you confirm your new selection.</p> }
        </details>
    }
    @if (Model.CanEdit)
    {
        <form method="post" id="preorder-form">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" name="ExpectedTotal" id="expected-total" />
            <partial name="_OrderingMenu" model="new KOMA.Services.OrderingMenu(Model.Menu, Model.Quantities, Model.Id)" />
        </form>
    }
    else { <p>This pre-order is no longer editable.</p><a asp-page="Details" asp-route-id="@Model.Id">Back to reservation</a> }
</section>
@section Scripts { <script src="~/js/preorder.js" asp-append-version="true"></script> }
