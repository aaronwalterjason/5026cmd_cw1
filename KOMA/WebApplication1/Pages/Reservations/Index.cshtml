@page
@model KOMA.Pages.Reservations.IndexModel
@{ ViewData["Title"] = "My reservations"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My reservations</h1>
    <a asp-page="Edit" class="btn btn-primary">Make a reservation</a>
</div>
@if (!Model.Bookings.Any())
{
    <p>You have no reservations yet. Make a reservation to plan your visit.</p>
}
else
{
    <p>All times are Malaysia time.</p>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Reference</th><th>Date and time</th><th>Table</th><th>Guests</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>R-@booking.Id.ToString("D5")</td>
                    <td>@booking.StartTime.ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@booking.RestaurantTable.TableNumber</td>
                    <td>@booking.GuestCount</td><td>@booking.Status</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="/Reservations/Details"
                               asp-route-id="@booking.Id"
                               class="btn btn-outline-secondary btn-sm">
                                View details
                            </a>

                            <a asp-page="/Reservations/PreOrder"
                               asp-route-id="@booking.Id"
                               class="btn btn-primary btn-sm">
                                Pre-order food / view order
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
