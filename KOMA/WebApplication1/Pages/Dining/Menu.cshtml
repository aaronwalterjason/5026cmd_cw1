@page
@model KOMA.Pages.Dining.MenuModel
@{ Layout = "_TabletLayout"; ViewData["Title"] = "Menu"; }
<link rel="stylesheet" href="~/css/preorder.css" asp-append-version="true"/>
<style>@@media(min-width:1000px){.po .tablet-order-columns{grid-template-columns:minmax(0,3fr) minmax(250px,1fr)}}</style>
<link rel="stylesheet" href="~/css/tablet-bill.css" asp-append-version="true"/>
<header class="tablet-heading"><div><h1>Hello, @Model.FirstName.</h1><p>Table @Model.Visit.RestaurantTable.TableNumber</p></div>
    <button type="button" id="open-visit-bill" class="btn btn-primary" aria-label="View total bill and food status">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg> Bill
    </button>
</header>
<p id="ordering-hours-message" class="alert alert-warning" role="status" hidden="@(!Model.Hours.Locked)">Ordering is closed. You can still view your bill and food status.</p>
<dialog id="visit-bill-dialog" aria-labelledby="visit-bill-title">
    <div class="d-flex justify-content-between align-items-center"><h2 id="visit-bill-title">Your total bill</h2><button type="button" class="btn-close" id="close-visit-bill" aria-label="Close bill"></button></div>
    <p id="bill-message" role="status"></p><div id="visit-bill-content"><partial name="_VisitBill" model="Model" /></div>
</dialog>
<dialog id="last-call-dialog" aria-labelledby="last-call-title"><h2 id="last-call-title">Last call soon</h2><p id="last-call-text"></p><button type="button" id="close-last-call" class="btn btn-primary">Continue browsing</button></dialog>
@if (TempData["DiningNotice"] is string notice) { <p class="alert alert-success" role="status">@notice</p> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<section class="po"><form method="post" id="preorder-form">
    <input type="hidden" name="ReviewedVisit" value="@Model.Visit.Id"/>
    <input type="hidden" name="Latest" value="@Model.Latest"/>
    <input type="hidden" name="PreorderReview" value="@Model.PreorderReview"/>
    <input type="hidden" name="ExpectedTotal" id="expected-total"/>
    <fieldset id="ordering-controls" disabled="@Model.Hours.Locked">
    <partial name="_OrderingMenu" model="new KOMA.Services.OrderingMenu(Model.Dishes, Model.Quantities, 0, true, Model.Preorder)" />
    </fieldset>
</form></section>
<link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
<section class="feedback-box" aria-label="Dining feedback"><iframe src="@Url.Page("/Feedback", new { tablet = true })" title="Dining feedback" loading="lazy"></iframe></section>
@section Scripts { <script src="~/js/preorder.js" asp-append-version="true"></script><script src="~/js/tablet-bill.js" asp-append-version="true"></script> }
