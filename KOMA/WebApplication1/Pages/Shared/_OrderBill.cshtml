@model KOMA.Models.Order
@{
    // Promotion lines (tablet orders only): ListPrice is the menu price before the discount.
    var saved = Model.Items.Where(i => i.ListPrice > i.UnitPrice).Sum(i => (i.ListPrice!.Value - i.UnitPrice) * i.Quantity);
}
<ul class="list-unstyled my-3 px-2">
    @foreach (var item in Model.Items.OrderBy(i => i.Id))
    {
        var promo = item.ListPrice is decimal list && list > item.UnitPrice;
        <li class="d-flex justify-content-between align-items-baseline gap-3 py-2">
            <span>@item.Quantity × @item.DishName
                @if (promo)
                {
                    <small class="bill-promo d-block">@item.PromotionTitle · @Math.Round((1 - item.UnitPrice / item.ListPrice!.Value) * 100)% off</small>
                }
            </span>
            <span class="text-nowrap text-end">
                @if (promo) { <s class="bill-was">RM @((item.ListPrice!.Value * item.Quantity).ToString("N2"))</s> }
                <strong>RM @item.LineTotal.ToString("N2")</strong>
            </span>
        </li>
    }
</ul>
@if (saved > 0)
{
    <div class="d-flex justify-content-between gap-3 px-2 pb-2 bill-saved">
        <span>Promotion savings</span><span class="text-nowrap">− RM @saved.ToString("N2")</span>
    </div>
}
<div class="d-flex justify-content-between gap-3 border-top pt-2 px-2">
    <span>Food total</span><strong class="text-nowrap">RM @Model.TotalAmount.ToString("N2")</strong>
</div>