@{
    var path = Context.Request.Path;
    var isHome = path == "/" || path == "/Index";
    var isBooking = path.StartsWithSegments("/Reservations");
}
<header class="customer-header">
    <a class="customer-brand" asp-area="" asp-page="/Index" aria-label="KOMA home"><span aria-hidden="true">こま</span>KOMA</a>
    <nav class="customer-links" aria-label="Main navigation">
        <a asp-area="" asp-page="/Index" aria-current="@(isHome ? "page" : null)">Home</a>
        <a asp-area="" asp-page="/Reservations/Index" aria-current="@(isBooking ? "page" : null)">My Reservations</a>
        <a asp-area="" asp-page="/Dining/Code">My dining QR</a>
    </nav>
    <nav class="customer-account" aria-label="Account">
        <span class="customer-greeting"><partial name="_AccountGreeting" /></span>
        <partial name="_AccountSettingsLink" />
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
            <button class="customer-logout" type="submit">Logout</button>
        </form>
    </nav>
</header>

