@using Microsoft.AspNetCore.Identity
@using KOMA.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var account = await UserManager.GetUserAsync(User);
    var path = Context.Request.Path;
    var isHome = path == "/" || path == "/Index";
    var isBooking = path.StartsWithSegments("/Reservations");
    var isAccount = path.StartsWithSegments("/Identity/Account/Manage");
}
<header class="customer-header">
    <a class="customer-brand" asp-area="" asp-page="/Index" aria-label="KOMA home"><span aria-hidden="true">こま</span>KOMA</a>
    <nav class="customer-links" aria-label="Main navigation">
        <a asp-area="" asp-page="/Index" aria-current="@(isHome ? "page" : null)">Home</a>
        <a asp-area="" asp-page="/Reservations/Index" aria-current="@(isBooking ? "page" : null)">My Reservations</a>
    </nav>
    <nav class="customer-account" aria-label="Account">
        <span class="customer-greeting">@(string.IsNullOrWhiteSpace(account?.FirstName) ? "My Account" : $"Hello, {account.FirstName}")</span>
        <a class="customer-account-icon" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="Account settings" title="Account settings" aria-current="@(isAccount ? "page" : null)">
            <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="16" cy="16" r="13" />
                <circle cx="16" cy="12" r="4" />
                <path d="M8 26v-3a8 6 0 0 1 16 0v3" />
            </svg>
        </a>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
            <button class="customer-logout" type="submit">Logout</button>
        </form>
    </nav>
</header>
