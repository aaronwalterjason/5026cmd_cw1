@model KOMA.Models.EmptyState
@*
    Shared "nothing here yet" display: a small line drawing, a title, a one-line hint and an optional action.
    Use it anywhere a page or card has no records:
        <partial name="_Empty" model='new EmptyState("bowl", "No dishes here yet", "Add the first dish.", "+ Add a dish", Url.Page(...))' />
    Compact = true gives a smaller side-by-side version for small dashboard cards.
    Drawings: bowl, tag, table, notebook, calendar, floor, search, people (navy lines, one rust accent).
*@
@{
    const string N = "#263b49", R = "#974535", P = "#eee7db", C = "#fbfaf6";
    string Line(string d, string c = N, string w = "2.5") => $"<path d=\"{d}\" fill=\"none\" stroke=\"{c}\" stroke-width=\"{w}\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>";
    var shadow = $"<ellipse cx=\"60\" cy=\"90\" rx=\"42\" ry=\"5\" fill=\"{P}\"/>";
    var art = Model.Art switch
    {
        "tag" => shadow + $"<path d=\"M30 22h34l28 28-34 34-28-28z\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>"
                 + $"<circle cx=\"44\" cy=\"36\" r=\"5\" fill=\"none\" stroke=\"{N}\" stroke-width=\"2.5\"/>" + Line("M48 60l16-16M52 70l20-20", R) + Line("M96 18v8M92 22h8M20 70v6M17 73h6", R, "2"),
        "table" => shadow + $"<rect x=\"26\" y=\"42\" width=\"68\" height=\"8\" rx=\"3\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/>"
                 + Line("M34 50v34M86 50v34M16 56v28M16 64h12M104 56v28M104 64h-12") + $"<ellipse cx=\"60\" cy=\"38\" rx=\"14\" ry=\"4\" fill=\"{C}\" stroke=\"{R}\" stroke-width=\"2.5\"/>" + Line("M54 30c0-4 4-4 4-8M64 30c0-4 4-4 4-8", R, "2"),
        "notebook" => shadow + $"<rect x=\"34\" y=\"14\" width=\"50\" height=\"68\" rx=\"5\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/>"
                 + Line("M44 32h30M44 44h30M44 56h18") + Line("M34 22h-6M34 36h-6M34 50h-6M34 64h-6") + Line("M76 70l18-18 5 5-18 18-7 2z", R),
        "calendar" => shadow + $"<rect x=\"26\" y=\"22\" width=\"68\" height=\"60\" rx=\"6\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/>"
                 + Line("M26 38h68M44 14v14M76 14v14") + Line("M40 52h6M56 52h6M72 52h6M40 66h6M56 66h6", N, "3") + $"<circle cx=\"75\" cy=\"66\" r=\"5\" fill=\"{R}\"/>",
        "floor" => shadow + $"<rect x=\"22\" y=\"20\" width=\"76\" height=\"62\" rx=\"4\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\" stroke-dasharray=\"6 5\"/>"
                 + $"<rect x=\"34\" y=\"32\" width=\"18\" height=\"14\" rx=\"3\" fill=\"none\" stroke=\"{N}\" stroke-width=\"2.5\"/><circle cx=\"78\" cy=\"40\" r=\"8\" fill=\"none\" stroke=\"{N}\" stroke-width=\"2.5\"/>"
                 + Line("M60 70h18M69 61v18", R),
        "search" => shadow + $"<circle cx=\"52\" cy=\"46\" r=\"22\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/>" + Line("M68 62l18 18", N, "4")
                 + Line("M46 40c0-4 3-6 6-6s6 2 6 6c0 4-6 4-6 9", R) + $"<circle cx=\"52\" cy=\"55\" r=\"1.8\" fill=\"{R}\"/>",
        "people" => shadow + $"<circle cx=\"48\" cy=\"36\" r=\"11\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/><circle cx=\"76\" cy=\"40\" r=\"9\" fill=\"{C}\" stroke=\"{R}\" stroke-width=\"2.5\"/>"
                 + Line("M26 80c0-14 10-24 22-24s22 10 22 24") + Line("M64 80c0-10 6-18 12-18s14 8 14 18", R),
        _ => shadow + $"<path d=\"M14 50h92a46 34 0 01-92 0z\" fill=\"{C}\" stroke=\"{N}\" stroke-width=\"2.5\"/>"   // bowl
                 + Line("M42 40c0-8 8-8 8-16M60 40c0-8 8-8 8-16M78 40c0-8 8-8 8-16", R) + Line("M30 50h60"),
    };
}
<div class="koma-empty @(Model.Compact ? "is-compact" : "")">
    <svg class="koma-empty-art" viewBox="0 0 120 100" aria-hidden="true" focusable="false">@Html.Raw(art)</svg>
    <div class="koma-empty-text">
        <b>@Model.Title</b>
        @if (!string.IsNullOrEmpty(Model.Text))
        {
            <span>@Model.Text</span>
        }
        @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionUrl))
        {
            <a class="koma-empty-btn" href="@Model.ActionUrl">@Model.ActionText</a>
        }
    </div>
</div>
