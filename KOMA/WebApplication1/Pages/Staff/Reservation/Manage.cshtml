@page
@model KOMA.Pages.Staff.Reservations.ManageModel
@using KOMA.Models

@{
    ViewData["Title"] = "Manage reservations";
}

<link rel="stylesheet"
      href="~/css/staff-workspace.css"
      asp-append-version="true" />

<div class="staff-workspace">
    <header class="staff-page-header">
        <div>
            <h1>Reservations</h1>
            <p class="text-muted">
                Search reservations and review guest details.
                All times are Malaysia time.
            </p>
        </div>

        <a asp-page="Index" class="btn btn-primary">
            Create reservation
            <span class="ms-2" aria-hidden="true">↗</span>
        </a>
    </header>



<div class="reservation-summary mb-4"
     aria-label="Booking counts for the date range and search, across all statuses">
    <div class="card">
        <div class="card-body">
            <span class="text-muted">Pending</span>
            <strong>@Model.Pending</strong>
            <small>Awaiting confirmation</small>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <span class="text-muted">Confirmed</span>
            <strong>@Model.Confirmed</strong>
            <small>Ready to welcome</small>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <span class="text-muted">Cancelled</span>
            <strong>@Model.Cancelled</strong>
            <small>Tables released</small>
        </div>
    </div>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label asp-for="Search" class="form-label">
                Search reservations
            </label>
            <input asp-for="Search"
                   class="form-control"
                   placeholder="Reference, guest, phone, email or table"
                   maxlength="256" />
        </div>

        <div class="col-sm-6 col-lg-2">
            <label asp-for="From" class="form-label">From date</label>
            <input asp-for="From" type="date" class="form-control" />
        </div>

        <div class="col-sm-6 col-lg-2">
            <label asp-for="To" class="form-label">To date</label>
            <input asp-for="To" type="date" class="form-control" />
        </div>

        <div class="col-sm-6 col-lg-2">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<ReservationStatus>()"
                    class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-2">
            <button class="btn btn-primary" type="submit">
                Apply filters
            </button>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mt-3 small">
        <a asp-page="Manage">Reset to upcoming</a>

        <a asp-page="Manage" asp-route-From="" asp-route-To="">
            View all history
        </a>

        <span class="text-muted">
            Counts above reflect the date range and search across all statuses.
        </span>
    </div>
</form>

<div asp-validation-summary="All"
     class="text-danger"
     role="alert">
</div>

@if (ViewData.ModelState.IsValid)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Guest list</h2>
        <span class="text-muted">
            @Model.Total reservation@(Model.Total == 1 ? "" : "s")
        </span>
    </div>

    @if (Model.Bookings.Count == 0)
    {
        <div class="card card-body text-center py-5">
            <h3 class="h5">No reservations found</h3>
            <p class="text-muted">
                Try another search or date range, or check table availability
                to create a booking.
            </p>
            <a asp-page="Index">Check table availability</a>
        </div>
    }
    else
    {
        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0 reservation-list">
                <caption class="px-3">
                    Reservations ordered by arrival time.
                    Use Review to confirm or cancel a booking.
                </caption>

                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference / arrival</th>
                        <th scope="col">Guest</th>
                        <th scope="col">Table / area</th>
                        <th scope="col">Guests</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        var canChange =
                            booking.Status != ReservationStatus.Cancelled &&
                            booking.StartTime > Model.Now;

                        var badge = booking.Status == ReservationStatus.Pending
                            ? "text-bg-warning"
                            : booking.Status == ReservationStatus.Confirmed
                                ? "text-bg-success"
                                : "text-bg-secondary";

                        <tr>
                            <td>
                                <a asp-page="Details"
                                   asp-route-id="@booking.Id"
                                   class="fw-semibold">
                                    R-@booking.Id.ToString("D5")
                                </a>

                                <div>
                                    @booking.StartTime.ToString("dd MMM yyyy")
                                </div>

                                <small class="text-muted">
                                    @booking.StartTime.ToString("HH:mm")
                                    –
                                    @booking.EndTime.ToString("HH:mm")
                                </small>
                            </td>

                            <td>
                                <strong>@booking.CustomerName</strong>
                                <div class="small">
                                    @booking.ContactNumber
                                </div>
                                <div class="small text-muted">
                                    @booking.Email
                                </div>

                                @if (!string.IsNullOrWhiteSpace(booking.SpecialRequests))
                                {
                                    <small class="text-muted">
                                        Special request · See details
                                    </small>
                                }
                            </td>

                            <td>
                                @booking.RestaurantTable.TableNumber
                                <div class="small text-muted">
                                    @booking.RestaurantTable.DiningArea?.Name
                                </div>
                            </td>

                            <td>@booking.GuestCount</td>

                            <td>
                                <span class="badge @badge">
                                    @booking.Status
                                </span>

                                @if (booking.StartTime <= Model.Now)
                                {
                                    <div class="small text-muted mt-1">
                                        @(booking.EndTime <= Model.Now
                                            ? "Past booking"
                                            : "Slot started")
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-page="Details"
                                       asp-route-id="@booking.Id"
                                       class="btn btn-outline-secondary btn-sm"
                                       aria-label="Review reservation R-@booking.Id.ToString("D5")">
                                        Review
                                    </a>

                                    @if (canChange)
                                    {
                                        <a asp-page="Edit"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-outline-primary btn-sm"
                                           aria-label="Edit reservation R-@booking.Id.ToString("D5")">
                                            Edit
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3"
                 aria-label="Reservation pages">
                <span>
                    Page @Model.PageNumber of @Model.TotalPages
                </span>

                <div class="d-flex gap-2">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="Manage"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-Search="@Model.Search"
                           asp-route-From="@(Model.From?.ToString("yyyy-MM-dd") ?? "")"
                           asp-route-To="@(Model.To?.ToString("yyyy-MM-dd") ?? "")"
                           asp-route-Status="@Model.Status"
                           class="btn btn-outline-secondary btn-sm">
                            Previous
                        </a>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-page="Manage"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-Search="@Model.Search"
                           asp-route-From="@(Model.From?.ToString("yyyy-MM-dd") ?? "")"
                           asp-route-To="@(Model.To?.ToString("yyyy-MM-dd") ?? "")"
                           asp-route-Status="@Model.Status"
                           class="btn btn-outline-secondary btn-sm">
                            Next
                        </a>
                    }
                </div>
            </nav>
        }
    }
}
</div>