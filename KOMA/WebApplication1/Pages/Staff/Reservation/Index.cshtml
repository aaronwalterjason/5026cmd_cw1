@page
@model KOMA.Pages.Staff.Reservations.IndexModel

@{
    ViewData["Title"] = "Table service";
}

<link rel="stylesheet"
      href="~/css/staff-reservation.css"
      asp-append-version="true" />

<div class="staff-reservations" id="table-workspace">
    <header class="d-flex justify-content-between flex-wrap gap-2 align-items-center mb-4">
        <div>
            <h1>Table service</h1>
            <p class="text-muted">
                Select a table to manage its booking and food orders.
                All times are Malaysia time.
            </p>
        </div>

        <a asp-page="/Staff/Reservation/Manage" asp-route-From="" asp-route-To="" class="btn btn-outline-secondary">
            View reservations
        </a>
    </header>

    <form method="get"
          id="slot-form"
          class="card card-body mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date"
                       type="date"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-4">
                <label asp-for="Time" class="form-label">Time slot</label>
                <select asp-for="Time" class="form-select">
                    @foreach (var slot in Model.Slots)
                    {
                        <option value="@slot.ToString("HH:mm")">
                            @slot.ToString("HH:mm") –
                            @slot.AddHours(1).ToString("HH:mm")
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">
                    Show availability
                </button>

                <a asp-page="Index"
                   asp-route-Now="true"
                   class="btn btn-outline-secondary">
                    Now
                </a>
            </div>
        </div>
    </form>

    <div asp-validation-summary="All"
         class="text-danger"
         role="alert"></div>

    <p id="workspace-error"
       class="text-danger"
       role="alert"></p>

    <div id="floor-host">
        @if (Model.ValidSlot)
        {
            <partial name="_ReservationFloor" model="Model" />
        }
    </div>

    <div class="modal fade"
         id="table-modal"
         tabindex="-1"
         aria-labelledby="table-modal-title"
         aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h4" id="table-modal-title">
                        Table details
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body" id="table-modal-body"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/layout-chairs.js"
            asp-append-version="true"></script>

    <script src="~/js/staff-table-popup.js"
            asp-append-version="true"></script>
}