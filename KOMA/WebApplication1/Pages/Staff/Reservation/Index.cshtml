@page
@model KOMA.Pages.Staff.Reservations.IndexModel
@using KOMA.Models
@{ ViewData["Title"] = "Reservations"; }
<link rel="stylesheet" href="~/css/staff-reservations.css" asp-append-version="true" />

<!-- Reservation Header -->
<div class="d-flex justify-content-between flex-wrap gap-2 align-items-center mb-4">
    <div><h1>Reservations</h1><p class="text-muted mb-0">Select a date and one-hour slot. All times are Malaysia time.</p></div>
    <a asp-page="/Staff/Index" class="btn btn-outline-secondary">Staff Dashboard</a>
</div>
<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-4"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" required /></div>
        <div class="col-sm-4"><label asp-for="Time" class="form-label">Time slot</label><select asp-for="Time" class="form-select">
            @foreach (var slot in Model.Slots) { <option value="@slot.ToString("HH:mm")">@slot.ToString("HH:mm") – @slot.AddHours(1).ToString("HH:mm")</option> }
        </select></div>
        <div class="col-sm-4"><button class="btn btn-primary" type="submit">Show availability</button></div>
    </div>
</form>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.ValidSlot)
{
    <p><span class="text-success fw-bold">✓ Available</span> · <span class="text-danger fw-bold">− Booked</span> · Pending bookings also hold a table.</p>
    <p class="text-muted">Schematic layout grouped by dining area; table positions do not represent the exact restaurant floor plan. Refresh availability before taking a booking.</p>
    @if (!Model.FutureSlot) { <div class="alert alert-info">You are viewing a past or started slot. New reservations are disabled.</div> }
    @if (!Model.Tables.Any()) { <div class="alert alert-info">No active tables are available. Ask the administrator to configure dining areas and tables.</div> }
    @foreach (var area in Model.Tables.GroupBy(t => t.DiningAreaId))
    {
        var diningArea = area.First().DiningArea!;

        <section class="floor-room mb-4" aria-label="@diningArea.Name">
            <div class="d-flex justify-content-between flex-wrap mb-3">
                <h2 class="h4">@diningArea.Name</h2>
                <span>@diningArea.Floor · @diningArea.Zone</span>
            </div>
            <div class="floor-tables">
                @foreach (var table in area)
                {
                    var booking = Model.Bookings.FirstOrDefault(r => r.RestaurantTableId == table.Id && r.Status != ReservationStatus.Cancelled);
                    var state = booking == null ? "available" : "booked";
                    var url = booking != null ? Url.Page("Details", new { id = booking.Id }) : Model.FutureSlot ? Url.Page("Edit", new { tableId = table.Id, date = Model.Date!.Value.ToString("yyyy-MM-dd"), time = Model.Time!.Value.ToString("HH:mm") }) : null;
                    <div class="table-position">
                        <span class="chairs" aria-hidden="true">▰ ▰</span>
                        @if (url != null)
                        {
                            <a href="@url" class="restaurant-table @state shape-@table.Shape.ToString().ToLowerInvariant()">
                                <strong>@table.TableNumber</strong><span>Capacity: @table.Capacity guests</span>
                                <span class="table-status">@(booking == null ? "✓ Available" : "− Booked")</span>
                                <small>@(booking == null ? "Create reservation" : $"{booking.Status} · View details")</small>
                            </a>
                        }
                        else { <div class="restaurant-table available"><strong>@table.TableNumber</strong><span>Capacity: @table.Capacity guests</span><span>✓ No booking</span><small>Slot has started</small></div> }
                        <span class="chairs" aria-hidden="true">▰ ▰</span>
                    </div>
                }
            </div>
        </section>
    }
    <!-- Reservation List -->
    <h2 class="h4 mt-4">Bookings for this slot</h2>
    @if (!Model.Bookings.Any()) { <p class="text-muted">No reservations for the selected slot.</p> }
    else
    {
        <div class="table-responsive"><table class="table table-bordered table-hover align-middle">
            <thead class="table-light"><tr><th>Reference</th><th>Table</th><th>Customer</th><th>Guests</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>@foreach (var booking in Model.Bookings) { <tr><td>R-@booking.Id.ToString("D5")</td><td>@booking.RestaurantTable.TableNumber</td><td>@booking.CustomerName</td><td>@booking.GuestCount</td><td>@booking.Status</td><td><a asp-page="Details" asp-route-id="@booking.Id">View details</a></td></tr> }</tbody>
        </table></div>
    }
}
