@model KOMA.Pages.Staff.Reservations.TablePanelModel
@using KOMA.Models
@using KOMA.Services

@{
    var booking = Model.Booking;
    var session = Model.Session;
}

<section class="table-panel"
         data-title="Table @Model.Table.TableNumber"
         data-current-table="@Model.TableId">

    <div class="table-panel-context">
        <strong>
            Table @Model.Table.TableNumber · Capacity @Model.Table.Capacity
        </strong>

        <div>@Model.Selection.Label</div>

        @if (booking != null)
        {
            <div>
                Booking R-@booking.Id.ToString("D5") ·
                @booking.CustomerName ·
                @booking.StartTime.ToString("HH:mm")–@booking.EndTime.ToString("HH:mm")
            </div>
        }
        else if (session != null)
        {
            <div>
                Walk-in · @session.CustomerName ·
                @session.StartTime.ToString("HH:mm")–@session.EndTime.ToString("HH:mm")
            </div>
        }
    </div>

    <div class="panel-message" role="status" aria-live="polite"></div>

    @if (Model.Bookings.Count + Model.WalkIns.Count > 1)
    {
        <p>More than one visit overlaps this selection. Choose the customer:</p>

        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var b in Model.Bookings)
            {
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        data-booking="@b.Id">
                    @b.CustomerName · @b.StartTime.ToString("HH:mm")
                </button>
            }

            @foreach (var s in Model.WalkIns)
            {
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        data-session="@s.Id">
                    @s.CustomerName · walk-in @s.StartTime.ToString("HH:mm")
                </button>
            }
        </div>
    }

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="booking-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#booking-panel"
                    type="button"
                    role="tab"
                    aria-controls="booking-panel"
                    aria-selected="true">
                Booking details
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="food-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#food-panel"
                    type="button"
                    role="tab"
                    aria-controls="food-panel"
                    aria-selected="false">
                Food orders
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active"
             id="booking-panel"
             role="tabpanel"
             aria-labelledby="booking-tab">

            @if (booking != null)
            {
                <div class="d-flex justify-content-between align-items-start gap-3"><p>
                    <strong>Status:</strong> @booking.Status ·
                    <strong>Guests:</strong> @booking.GuestCount
                </p>
                    @if (booking.EndTime > ReservationRules.MalaysiaNow)
                    { <a class="btn btn-outline-primary flex-shrink-0 d-inline-flex align-items-center gap-1 lh-1" asp-page="/Reservations/Edit" asp-route-id="@booking.Id"><partial name="_EditLabel" /></a> }
                </div>

                <p>
                    <strong>Contact:</strong>
                    @booking.ContactNumber · @booking.Email
                </p>
                <p style="white-space:pre-wrap"><strong>Requests:</strong> @(booking.SpecialRequests ?? "None")</p>


            }
            else if (session != null)
            {
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <p><strong>Walk-in guest:</strong> @session.CustomerName · @session.GuestCount guests</p>
                    @if (session.EndTime > ReservationRules.MalaysiaNow)
                    {
                        <button type="button" class="btn btn-outline-primary flex-shrink-0 d-inline-flex align-items-center gap-1 lh-1"
                                data-bs-toggle="collapse" data-bs-target="#walk-in-table-editor"
                                aria-expanded="false" aria-controls="walk-in-table-editor"><partial name="_EditLabel" /></button>
                    }
                </div>
                <p><strong>Contact:</strong> @(session.ContactNumber ?? "Not provided")</p>

                @if (session.EndTime > ReservationRules.MalaysiaNow)
                {
                    <div class="collapse" id="walk-in-table-editor">
                    @if (Model.MoveTargets.Count == 0) { <p>No other table is available for this visit.</p> }
                    else
                    {
                        <form method="post" asp-page="TablePanel" asp-page-handler="MoveWalkIn" class="walk-in-move mt-3">
                            <input type="hidden" name="TableId" value="@Model.TableId"/>
                            <input type="hidden" name="SessionId" value="@session.Id"/>
                            <label for="move-table">New table</label>
                            <select class="form-select mb-2" name="destination" id="move-table" required>
                                <option value="">Choose a table</option>
                                @foreach (var table in Model.MoveTargets) { <option value="@table.Id">@table.TableNumber · seats @table.Capacity</option> }
                            </select>
                            <button type="submit" class="btn btn-primary">Move guest</button>
                        </form>
                    }
                    </div>
                }
            }

            @if (booking == null && session == null) { <p>No visit at this time.</p> }
        </div>
        <div class="tab-pane fade" id="food-panel" role="tabpanel" aria-labelledby="food-tab">
            @if (Model.Orders.Count == 0) { <p>No food orders have been submitted for this visit.</p> }
            @foreach (var order in Model.Orders)
            {
                <article class="card card-body mb-2">
                    <h3 class="h6">@order.OrderNumber · @order.Status.DisplayName() · @order.PaymentStatus</h3>
                    <partial name="_OrderBill" model="order" />
                </article>
            }
            @if (Model.Outstanding.Any())
            {
                <div class="text-end mt-3"><button type="button" class="btn btn-primary" data-open-payment>Confirm payment</button></div>
                <dialog class="visit-payment" aria-labelledby="payment-title">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 id="payment-title" class="h5 m-0">Confirm payment</h3>
                        <button type="button" class="btn-close" aria-label="Close payment" data-close-payment></button>
                    </div>
                    <p class="mt-3 mb-0">Amount due <strong>RM @Model.Outstanding.Sum(o => o.TotalAmount).ToString("F2")</strong></p>
                    <form method="post" asp-page="TablePanel" asp-page-handler="Settle" class="payment-form">
                        <input type="hidden" name="TableId" value="@Model.TableId"/>
                        <input type="hidden" name="BookingId" value="@Model.BookingId"/>
                        <input type="hidden" name="SessionId" value="@(booking == null ? session?.Id : null)"/>
                        <input type="hidden" name="Date" value="@(Model.Date?.ToString("yyyy-MM-dd"))"/>
                        <input type="hidden" name="Time" value="@(Model.Time?.ToString("HH:mm"))"/>
                        <input type="hidden" name="At" value="@(Model.At?.ToString("O"))"/>
                        <input type="hidden" name="billToken" value="@Model.BillToken"/>
                        <fieldset>
                            <legend>Payment method</legend>
                            <div class="payment-options">
                                <label><input type="radio" name="method" value="Cash" required/> Cash</label>
                                <label><input type="radio" name="method" value="TouchNGo" required/> eWallet</label>
                                <label><input type="radio" name="method" value="Card" required/> Card</label>
                            </div>
                        </fieldset>
                        <button class="btn btn-primary" type="submit">Pay</button>
                    </form>
                </dialog>
            }
            else if (Model.Orders.Any(o => o.PaymentStatus == PaymentStatus.Paid))
            {
                <div class="text-end mt-3"><button class="btn btn-primary" type="button" disabled>Paid</button></div>
            }
        </div>
    </div>
</section>
