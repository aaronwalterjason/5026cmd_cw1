@model KOMA.Pages.Staff.Reservations.IndexModel
@using KOMA.Models
@using System.Globalization

@functions {
    private static string Num(double value)
        => value.ToString(CultureInfo.InvariantCulture);

    private static string Pct(double value, double total)
        => Num(value / total * 100) + "%";
}

<div class="floor-board"
     data-live="@(Model.Now ? "true" : "false")"
     data-panel-url="@Url.Page("TablePanel", Model.PanelContext)"
     data-refresh-url="@Url.Page("Index", "Floor", new
     {
         Date = Model.Date?.ToString("yyyy-MM-dd"),
         Time = Model.Time?.ToString("HH:mm"),
         Now = Model.Now
     })">

    <p class="fw-bold">@Model.Selection!.Label</p>

    <p>
        <span class="text-success">✓ Available</span> ·
        <span class="text-danger">− Booked / walk-in</span> ·
        <span class="text-muted">× Closed</span>
    </p>

    <p class="small text-muted">
        Availability reflects the time shown above.
        @(Model.Now ? "Current availability refreshes automatically." : "Select Now to see current availability.")
    </p>

    @foreach (var booking in Model.CallsDue)
    {
        <div class="alert alert-warning">Call @booking.CustomerName · <a href="tel:@booking.ContactNumber">@booking.ContactNumber</a>
        <button class="btn btn-outline-secondary btn-sm" data-open-table="@booking.RestaurantTableId">Open table @booking.RestaurantTable.TableNumber</button></div>
    }
    @if (!Model.Selection.IsOpen)
    {
        <div class="alert alert-info">
            The restaurant is closed at the selected time.
        </div>
    }

    @if (!Model.Floors.Any())
    {
        <div class="alert alert-info">
            No floor layouts have been created yet.
            Ask the administrator to create and save a layout.
        </div>
    }

    @foreach (var floor in Model.Floors)
    {
        if (floor.Width <= 0 || floor.Height <= 0)
        {
            <div class="alert alert-warning">
                @floor.Name has invalid dimensions.
                Ask the administrator to update this layout.
            </div>
            continue;
        }

        <section class="reservation-floor mb-4">
            <h2 class="h4">@floor.Name</h2>

            <p class="small text-muted">
                Select a table to view its booking and food orders.
                On smaller screens, scroll sideways to see the whole floor.
            </p>

            <div class="reservation-floor-scroll"
                 tabindex="0"
                 role="region"
                 aria-label="@($"{floor.Name} table layout")">

                <div class="lay-preview live-map reservation-map"
                     style="aspect-ratio:@Num(floor.Width) / @Num(floor.Height)"
                     data-floor-w="@Num(floor.Width)"
                     data-floor-h="@Num(floor.Height)">

                    @foreach (var area in floor.DiningAreas)
                    {
                        <div class="lay-preview-area @KOMA.Pages.Admin.Layouts.IndexModel.ZoneClass(area.Zone) @(area.IsActive ? "" : "is-closed")"
                             style="left:@Pct(area.LayoutX, floor.Width);top:@Pct(area.LayoutY, floor.Height);width:@Pct(area.LayoutWidth, floor.Width);height:@Pct(area.LayoutHeight, floor.Height)">
                            <span class="live-area-name">@area.Name</span>
                        </div>
                    }

                    @foreach (var area in floor.DiningAreas)
                    {
                        foreach (var table in area.Tables)
                        {
                            var hasBooking = Model.Bookings.Any(r =>
                                r.RestaurantTableId == table.Id);

                            var hasWalkIn = Model.WalkIns.Any(s =>
                                s.RestaurantTableId == table.Id);

                            var blocked = Model.BlockedTables.Contains(table.Id);
                            var occupied = hasBooking || hasWalkIn || blocked;

                            var closed =
                                !area.IsActive ||
                                !table.IsActive ||
                                !Model.Selection.IsOpen;

                            var stateClass = closed
                                ? "reservation-closed"
                                : occupied
                                    ? "reservation-booked"
                                    : "reservation-available";

                            var status = closed
                                ? "Closed"
                                : occupied
                                    ? (hasBooking || hasWalkIn ? "Booked or walk-in" : "Unavailable for this slot")
                                    : "Available";

                            var symbol = closed
                                ? "×"
                                : occupied ? "−" : "✓";

                            var label =
                                $"Table {table.TableNumber}, " +
                                $"capacity {table.Capacity} guests, {status}";

                            var style =
                                $"left:{Pct(table.LayoutX, floor.Width)};" +
                                $"top:{Pct(table.LayoutY, floor.Height)};" +
                                $"width:{Pct(table.LayoutWidth, floor.Width)};" +
                                $"height:{Pct(table.LayoutHeight, floor.Height)};";

                            <button type="button"
                                    data-open-table="@table.Id"
                                    class="lay-preview-table live-table reservation-map-table @stateClass @(table.Shape == TableShape.Round ? "is-round" : "")"
                                    style="@style"
                                    title="@label"
                                    aria-label="@label"
                                    data-x="@Num(table.LayoutX)"
                                    data-y="@Num(table.LayoutY)"
                                    data-w="@Num(table.LayoutWidth)"
                                    data-h="@Num(table.LayoutHeight)"
                                    data-shape="@table.Shape"
                                    data-capacity="@table.Capacity">
                                <span>@table.TableNumber @symbol</span>
                                <small>@table.Capacity guests</small>
                            </button>
                        }
                    }
                </div>
            </div>
        </section>
    }
</div>
