@page
@model KOMA.Pages.Staff.IndexModel

@{
    ViewData["Title"] = "Staff Dashboard";
}

<link rel="stylesheet"
      href="~/css/staff-workspace.css"
      asp-append-version="true" />

<div class="staff-workspace">
    <header class="staff-page-header">
        <div>
            <h1>Staff Dashboard</h1>
            <p class="text-muted">
                Manage table service and kitchen preparation.
            </p>
        </div>

        <span class="small text-muted">
            Welcome, @User.Identity?.Name
        </span>
    </header>



    <div class="staff-action-grid">
        <section class="card p-3 staff-action-card"
                 aria-labelledby="table-service-title">

            <span class="h6 mb-0">Floor staff</span>

            <h2 id="table-service-title" class="h4">
                Table service
            </h2>

            <p class="text-muted">
                Check table availability, manage bookings and walk-ins,
                review customer orders, confirm orders for the kitchen,
                and mark ready orders served.
            </p>

            <a asp-page="/Staff/Reservation/Index"
               class="btn btn-primary">
                Open table service
                <span aria-hidden="true">↗</span>
            </a>
        </section>

        <section class="card p-3 staff-action-card"
                 aria-labelledby="kitchen-title">

            <span class="h6 mb-0">Kitchen staff</span>

            <h2 id="kitchen-title" class="h4">
                Kitchen queue
            </h2>

            <p class="text-muted">
                View confirmed customer orders, start preparation,
                and mark orders ready for serving.
            </p>

            <a asp-page="/Staff/Orders/Kitchen"
               class="btn btn-primary">
                Open kitchen queue
                <span aria-hidden="true">↗</span>
            </a>
        </section>
    </div>
</div>