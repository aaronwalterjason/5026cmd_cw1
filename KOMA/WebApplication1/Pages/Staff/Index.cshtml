@page
@model KOMA.Pages.Staff.IndexModel

@{
    ViewData["Title"] = "Staff Dashboard";
}


    <header class="staff-page-header">
        <div>
            <h1>Staff Dashboard</h1>
            <p class="text-muted">
                Check tables, manage kitchen orders or set up a tablet.
            </p>
        </div>

        <span class="small text-muted">
            Welcome, @User.Identity?.Name
        </span>
    </header>



    <div class="staff-action-grid">
        <section class="card p-3 staff-action-card"
                 aria-labelledby="table-service-title">

            <span class="h6 mb-0">Floor staff</span>

            <h2 id="table-service-title" class="h4">
                Table service
            </h2>

            <p class="text-muted">
                Check reservations and view the food orders submitted for each table.
            </p>

            <a asp-page="/Staff/Reservation/Index" asp-route-Now="true"
               class="btn btn-primary">
                Open table service
                <span aria-hidden="true">↗</span>
            </a>
        </section>

        <section class="card p-3 staff-action-card"
                 aria-labelledby="kitchen-title">

            <span class="h6 mb-0">Kitchen staff</span>

            <h2 id="kitchen-title" class="h4">
                Kitchen queue
            </h2>

            <p class="text-muted">
                View confirmed customer orders, start preparation,
                and mark orders ready for serving.
            </p>

            <a asp-page="/Staff/Orders/Kitchen"
               class="btn btn-primary">
                Open kitchen queue
                <span aria-hidden="true">↗</span>
            </a>
        </section>
        <section class="card p-3 staff-action-card">
            <h2 class="h4">Tablet mode</h2>
            <p class="text-muted">Set up this tablet for a table or help a guest order.</p>
            <a asp-page="/Dining/Setup" class="btn btn-primary">Open tablet mode <span aria-hidden="true">↗</span></a>
        </section>
    </div>

