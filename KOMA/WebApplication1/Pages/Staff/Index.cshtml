@page
@model KOMA.Pages.Staff.IndexModel

@{
    ViewData["Title"] = "Staff Dashboard";
}

<link rel="stylesheet"
      href="~/css/staff-dashboard.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/staff-responsive.css"
      asp-append-version="true" />

<div class="staff-dashboard">

    <!-- Dashboard Header -->
    <header>
        <p class="staff-eyebrow">KOMA · Staff workspace</p>

        <h1>Staff Dashboard</h1>

        <p class="staff-welcome">
            Welcome, @User.Identity?.Name!
        </p>

        <p class="staff-intro">
            Manage restaurant reservations and help every guest
            enjoy their time at KOMA.
        </p>
    </header>

    <!-- Staff Functions -->
    <div class="staff-feature-grid">

        <!-- Reservations -->
        <section class="staff-feature-card"
                 aria-labelledby="reservations-title">

            <span class="staff-feature-label">
                GUEST BOOKINGS
            </span>

            <h2 id="reservations-title">Reservations</h2>

            <p>
                Check table availability, view guest details
                and manage upcoming reservations.
            </p>

            <a asp-page="/Staff/Reservation/Index"
               class="staff-button">
                Open reservations
                <span aria-hidden="true">↗</span>
            </a>

        </section>

    </div>

</div>