@page
@model RROMS.Areas.Admin.Pages.MenuCategories.IndexModel
@{
    ViewData["Title"] = "Menu Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Menu Categories</h1>
    <a class="btn btn-primary" asp-page="./Create">+ New category</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Order</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Categories)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.DisplayOrder</td>
            <td>@(c.IsActive ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-page="./Edit" asp-route-id="@c.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
