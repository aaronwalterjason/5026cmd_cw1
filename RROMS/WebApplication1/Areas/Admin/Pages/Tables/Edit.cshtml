@page "{id:int}"
@model RROMS.Areas.Admin.Pages.Tables.EditModel
@{
    ViewData["Title"] = "Edit Table";
}

<h1>Edit Table</h1>

<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Table.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Table.TableNumber" class="form-label"></label>
        <input asp-for="Table.TableNumber" class="form-control" />
        <span asp-validation-for="Table.TableNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Table.DiningAreaId" class="form-label">Dining Area</label>
        <select asp-for="Table.DiningAreaId" asp-items="Model.DiningAreaOptions" class="form-select">
        </select>
        <span asp-validation-for="Table.DiningAreaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Table.Capacity" class="form-label"></label>
        <input asp-for="Table.Capacity" class="form-control" />
        <span asp-validation-for="Table.Capacity" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Table.IsActive" class="form-check-input" />
        <label asp-for="Table.IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>
