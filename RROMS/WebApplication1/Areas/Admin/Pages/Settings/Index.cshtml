@page
@model RROMS.Areas.Admin.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Restaurant Settings";
}

<h1>Restaurant Settings</h1>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="OpeningTime" class="form-label">Opening time</label>
        <input asp-for="OpeningTime" type="time" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ClosingTime" class="form-label">Closing time</label>
        <input asp-for="ClosingTime" type="time" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="AnnouncementText" class="form-label">Announcement banner</label>
        <textarea asp-for="AnnouncementText" class="form-control" rows="2" placeholder="e.g. Closed for a private event on 14 Sep"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save settings</button>
</form>
